<%
/*
 * Abre a estrutura de duas colunas (sidebar do fluxo + conteúdo) e NÃO
 * fecha as divs — cada página de seção escreve seu conteúdo logo em
 * seguida e fecha </div></div> antes do partials/footer. Truque necessário
 * porque EJS não tem layout/yield nativo. Esta é a navegação CONTEXTUAL de
 * um fluxo específico — diferente da sidebar principal do app (que fica
 * fora de <main>, em partials/footer.ejs).
 */
%>
<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
  <h2 class="text-xl font-bold text-base-content">
    <%= flow.name %> <span class="text-base-content/40 font-normal text-base">(<%= flow.key %>)</span>
  </h2>
  <a class="btn btn-outline btn-sm" href="/admin/flows">&larr; Todos os fluxos</a>
</div>

<div class="flex flex-col lg:flex-row gap-6 items-start">
  <aside class="w-full lg:w-56 shrink-0 bg-base-200 border border-base-300 rounded-2xl p-3 lg:sticky lg:top-6">
    <%
      function navGroup(title) { %>
        <div class="text-xs font-semibold uppercase tracking-wider text-base-content/40 px-3 pt-3 pb-1"><%= title %></div>
      <% }
      function navLink(href, key, label) { %>
        <a href="<%= href %>" class="flex items-center justify-between rounded-lg px-3 py-2 text-sm no-underline transition-colors <%= section === key
          ? "bg-primary/15 text-primary font-semibold"
          : "text-base-content/70 hover:bg-base-300/60 hover:text-base-content" %>"><%= label %></a>
      <% }
      function navSoon(label) { %>
        <span class="flex items-center justify-between rounded-lg px-3 py-2 text-sm text-base-content/35">
          <%= label %> <span class="text-[10px] bg-base-300 text-base-content/50 px-2 py-0.5 rounded-full">em breve</span>
        </span>
      <% }
    %>
    <div class="flex flex-col gap-0.5">
      <% navGroup("Estrutura"); %>
      <% navLink(`/admin/flows/${flow.id}/bots`, "bots", "Bots"); %>
      <% navLink(`/admin/flows/${flow.id}/welcome`, "welcome", "Boas-vindas"); %>
      <% navLink(`/admin/flows/${flow.id}/plans`, "plans", "Planos"); %>

      <% navGroup("Conversão"); %>
      <% navLink(`/admin/flows/${flow.id}/offers`, "offers", "Order Bump"); %>
      <% navLink(`/admin/flows/${flow.id}/upsell`, "upsell", "Upsell"); %>
      <% navLink(`/admin/flows/${flow.id}/downsell`, "downsell", "Downsell"); %>
      <% navLink(`/admin/flows/${flow.id}/packs`, "packs", "Packs"); %>
      <% navSoon("Prévias"); %>

      <% navGroup("Operação"); %>
      <% navLink(`/admin/flows/${flow.id}/payments`, "payments", "Pagamentos"); %>
      <% navSoon("Top Assinantes"); %>
    </div>
  </aside>

  <div class="flex-1 min-w-0 w-full">
