<% const w = flow.welcomeConfig || {}; %>
<%- include("../partials/header", { title: flow.name + " — Boas-vindas", active: "flows" }) %>
<%- include("./partials/nav", { flow, section: "welcome" }) %>

<div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
  <div class="card-body">
    <h3 class="font-semibold mb-2">Mídias (até 3)</h3>
    <div class="flex flex-col divide-y divide-base-300 mb-2">
      <% (w.media || []).forEach(function(m) { %>
        <div class="flex items-center justify-between py-2 text-sm">
          <span><%= m.mediaType %> — <code class="text-xs bg-base-300/60 px-1.5 py-0.5 rounded"><%= m.fileId.slice(0, 24) %>…</code></span>
          <form method="POST" action="/admin/flows/<%= flow.id %>/welcome/media/<%= m.id %>/delete" onsubmit="return confirm('Remover esta mídia?');">
            <button class="btn btn-xs btn-error btn-outline" type="submit">Remover</button>
          </form>
        </div>
      <% }); %>
      <% if ((w.media || []).length === 0) { %><p class="text-base-content/50 py-2">Nenhuma mídia ainda.</p><% } %>
    </div>

    <% if ((w.media || []).length < 3) { %>
      <form method="POST" action="/admin/flows/<%= flow.id %>/welcome/media" class="flex flex-col gap-3 mt-2 pt-3 border-t border-base-300">
        <label class="form-control">
          <div class="label"><span class="label-text">Tipo</span></div>
          <select name="mediaType" class="select select-bordered select-sm w-full max-w-xs">
            <option value="PHOTO">Foto</option>
            <option value="VIDEO">Vídeo</option>
            <option value="AUDIO">Áudio</option>
            <option value="DOCUMENT">Documento</option>
          </select>
        </label>
        <label class="form-control">
          <div class="label"><span class="label-text">file_id do Telegram</span></div>
          <input type="text" name="fileId" required placeholder="AgACAgEAAx0..." class="input input-bordered input-sm w-full" />
          <div class="label"><span class="label-text-alt text-base-content/60">Ainda não dá pra fazer upload direto pela tela — envie a mídia pro bot uma vez e capture o file_id retornado pela API.</span></div>
        </label>
        <div><button class="btn btn-sm btn-primary" type="submit">Adicionar mídia</button></div>
      </form>
    <% } %>
  </div>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
  <div class="card-body">
    <h3 class="font-semibold mb-2">Mensagem de boas-vindas</h3>
    <form method="POST" action="/admin/flows/<%= flow.id %>/welcome" class="flex flex-col gap-4">
      <div>
        <div class="label"><span class="label-text">Texto</span></div>
        <div class="flex gap-1 mb-2">
          <button type="button" class="btn btn-xs btn-square btn-ghost" title="Negrito" onclick="dgWrapSelection('text','&lt;b&gt;','&lt;/b&gt;')"><b>B</b></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" title="Itálico" onclick="dgWrapSelection('text','&lt;i&gt;','&lt;/i&gt;')"><i>I</i></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" title="Sublinhado" onclick="dgWrapSelection('text','&lt;u&gt;','&lt;/u&gt;')"><u>U</u></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" title="Tachado" onclick="dgWrapSelection('text','&lt;s&gt;','&lt;/s&gt;')"><s>S</s></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" title="Código" onclick="dgWrapSelection('text','&lt;code&gt;','&lt;/code&gt;')">&lt;/&gt;</button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" title="Citação" onclick="dgWrapSelection('text','&lt;blockquote&gt;','&lt;/blockquote&gt;')">&rdquo;</button>
        </div>
        <textarea id="text" name="text" rows="5" class="textarea textarea-bordered w-full"><%= w.text || "" %></textarea>
        <div class="flex gap-1.5 flex-wrap mt-2">
          <% ["nome","email","telefone","estado","uf","cidade","localizacao","saudacao","bot.nome","bot.username"].forEach(function(v) { %>
            <button type="button" class="badge badge-outline hover:badge-primary cursor-pointer" onclick="dgInsertAtCursor('text', '{<%= v %>}')">{<%= v %>}</button>
          <% }); %>
        </div>
        <p class="text-xs text-base-content/50 mt-2">Campos que o Telegram não fornece (email, telefone, cidade, estado, uf, localização) renderizam vazio.</p>
      </div>

      <label class="label cursor-pointer justify-start gap-3 px-0">
        <input type="checkbox" name="secondaryMessageEnabled" <%= w.secondaryMessageEnabled ? "checked" : "" %> class="checkbox checkbox-primary checkbox-sm" />
        <span class="label-text">Enviar como mensagem separada da mídia (em vez de legenda)</span>
      </label>

      <label class="label cursor-pointer justify-start gap-3 px-0">
        <input type="checkbox" name="ctaButtonEnabled" <%= w.ctaButtonEnabled ? "checked" : "" %> class="checkbox checkbox-primary checkbox-sm" />
        <span class="label-text">Mostrar botão de call-to-action (leva pra lista de planos)</span>
      </label>
      <label class="form-control">
        <div class="label"><span class="label-text">Texto do botão CTA</span></div>
        <input type="text" name="ctaLabel" value="<%= w.ctaLabel || "" %>" placeholder="Ver planos" class="input input-bordered w-full" />
      </label>

      <label class="label cursor-pointer justify-start gap-3 px-0">
        <input type="checkbox" name="miniAppEnabled" <%= w.miniAppEnabled ? "checked" : "" %> class="checkbox checkbox-primary checkbox-sm" />
        <span class="label-text">Botão de Mini App</span>
      </label>
      <label class="form-control">
        <div class="label"><span class="label-text">URL do Mini App</span></div>
        <input type="text" name="miniAppUrl" value="<%= w.miniAppUrl || "" %>" placeholder="https://..." class="input input-bordered w-full" />
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Canal/grupo-cofre padrão (entrega de conteúdo)</span></div>
        <input type="text" name="defaultDeliveryTarget" value="<%= w.defaultDeliveryTarget || "" %>" placeholder="-1001234567890" class="input input-bordered w-full" />
        <div class="label"><span class="label-text-alt text-base-content/60">Id do canal privado onde os produtos ficam postados. Cada plano pode sobrescrever isso individualmente.</span></div>
      </label>

      <div><button class="btn btn-primary" type="submit">Salvar boas-vindas</button></div>
    </form>
  </div>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm">
  <div class="card-body">
    <h3 class="font-semibold mb-2">Botões de redirecionamento (até 3)</h3>
    <div class="flex flex-col divide-y divide-base-300 mb-2">
      <% (w.redirectButtons || []).forEach(function(rb) { %>
        <div class="flex items-center justify-between py-2 text-sm">
          <span><%= rb.label %> → <%= rb.url %></span>
          <form method="POST" action="/admin/flows/<%= flow.id %>/welcome/redirect-buttons/<%= rb.id %>/delete" onsubmit="return confirm('Remover este botão?');">
            <button class="btn btn-xs btn-error btn-outline" type="submit">Remover</button>
          </form>
        </div>
      <% }); %>
      <% if ((w.redirectButtons || []).length === 0) { %><p class="text-base-content/50 py-2">Nenhum botão de redirecionamento ainda.</p><% } %>
    </div>

    <% if ((w.redirectButtons || []).length < 3) { %>
      <form method="POST" action="/admin/flows/<%= flow.id %>/welcome/redirect-buttons" class="flex flex-col gap-3 mt-2 pt-3 border-t border-base-300">
        <label class="form-control">
          <div class="label"><span class="label-text">Texto do botão</span></div>
          <input type="text" name="label" required placeholder="Canal VIP" class="input input-bordered input-sm w-full" />
        </label>
        <label class="form-control">
          <div class="label"><span class="label-text">URL</span></div>
          <input type="text" name="url" required placeholder="https://t.me/seu_canal" class="input input-bordered input-sm w-full" />
        </label>
        <div><button class="btn btn-sm btn-primary" type="submit">Adicionar botão</button></div>
      </form>
    <% } %>
  </div>
</div>

  </div>
</div>
<%- include("../partials/footer", { active: "flows" }) %>
