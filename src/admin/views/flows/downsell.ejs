<%- include("../partials/header", { title: flow.name + " — Downsell", active: "flows" }) %>
<%- include("./partials/nav", { flow, section: "downsell" }) %>

<form method="POST" action="/admin/flows/<%= flow.id %>/downsell" class="mb-4">
  <label class="label cursor-pointer justify-start gap-3 px-0 w-fit">
    <input type="checkbox" name="active" onchange="this.form.submit()" <%= config.active ? "checked" : "" %> class="checkbox checkbox-primary checkbox-sm" />
    <span class="label-text">Ativar Downsell</span>
  </label>
</form>

<div role="tablist" class="tabs tabs-boxed w-fit mb-4">
  <a role="tab" href="/admin/flows/<%= flow.id %>/downsell?tab=geral" class="tab <%= activeTab === 'geral' ? 'tab-active' : '' %>">Geral</a>
  <a role="tab" href="/admin/flows/<%= flow.id %>/downsell?tab=pix" class="tab <%= activeTab === 'pix' ? 'tab-active' : '' %>">PIX Gerado</a>
</div>

<% if (activeTab === 'geral') { %>
  <div class="alert bg-primary/10 border border-primary/30 text-base-content text-sm mb-6 py-2.5">
    Sequências enviadas após o /start para leads que não geraram pagamento.
  </div>
<% } else { %>
  <div class="alert bg-primary/10 border border-primary/30 text-base-content text-sm mb-6 py-2.5">
    Sequências enviadas quando o lead gera pagamento mas não paga. Quando ativo, substitui o downsell Geral para esses leads.
  </div>
<% } %>

<% const sequences = config.sequences.filter(function(s) { return s.trigger === (activeTab === 'pix' ? 'PIX_GENERATED' : 'GENERAL'); }); %>

<div class="flex items-center justify-between mb-3">
  <h3 class="font-semibold">Sequências de Downsell</h3>
  <span class="text-sm text-base-content/50"><%= sequences.length %>/20</span>
</div>

<% sequences.forEach(function(seq, idx) { %>
  <div class="card bg-base-200 border border-base-300 shadow-sm mb-4">
    <div class="card-body">
      <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <h3 class="font-semibold">Sequência <%= idx + 1 %> <% if (!seq.active) { %><span class="badge badge-ghost badge-sm ml-1">pausada</span><% } %></h3>
        <div class="flex gap-1.5">
          <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>/toggle" class="inline">
            <button class="btn btn-xs btn-outline" type="submit"><%= seq.active ? "Pausar" : "Ativar" %></button>
          </form>
          <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>/duplicate" class="inline">
            <button class="btn btn-xs btn-outline" type="submit" title="Duplicar">Duplicar</button>
          </form>
          <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>/delete" class="inline" onsubmit="return confirm('Excluir esta sequência inteira?');">
            <button class="btn btn-xs btn-error btn-outline" type="submit">Excluir</button>
          </form>
        </div>
      </div>

      <div class="text-xs uppercase tracking-wider text-base-content/40 mb-1">Mídias (até 3)</div>
      <div class="overflow-x-auto mb-2">
        <table class="table table-sm">
          <tbody>
            <% seq.media.forEach(function(m) { %>
              <tr>
                <td><%= m.mediaType %></td>
                <td class="text-base-content/50"><%= m.fileId.slice(0, 24) %>…</td>
                <td>
                  <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>/media/<%= m.id %>/delete" class="inline">
                    <button class="btn btn-xs btn-error btn-outline" type="submit">Remover</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (seq.media.length < 3) { %>
        <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>/media" class="flex gap-2 items-center flex-wrap mt-2">
          <select name="mediaType" class="select select-bordered select-sm">
            <option value="PHOTO">Foto</option>
            <option value="VIDEO">Vídeo</option>
            <option value="AUDIO">Áudio</option>
            <option value="DOCUMENT">Documento</option>
          </select>
          <input type="text" name="fileId" placeholder="file_id do Telegram" class="input input-bordered input-sm flex-1 min-w-[160px]" />
          <button class="btn btn-sm btn-outline" type="submit">+ Adicionar mídia</button>
        </form>
      <% } %>

      <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>" class="flex flex-col gap-1 mt-4">
        <div class="flex gap-4 flex-wrap mb-2">
          <label class="form-control w-36">
            <div class="label"><span class="label-text text-xs">Enviar (min. após <%= activeTab === 'pix' ? 'o PIX gerado' : 'o /start' %>)</span></div>
            <input type="number" name="delayMinutes" min="0" value="<%= seq.delayMinutes %>" class="input input-bordered input-sm w-full" />
          </label>
          <label class="form-control w-28">
            <div class="label"><span class="label-text text-xs">Tipo de desconto</span></div>
            <select name="discountType" class="select select-bordered select-sm w-full">
              <option value="PERCENT" <%= seq.discountType === "PERCENT" ? "selected" : "" %>>%</option>
              <option value="FIXED" <%= seq.discountType === "FIXED" ? "selected" : "" %>>R$</option>
            </select>
          </label>
          <label class="form-control w-28">
            <div class="label"><span class="label-text text-xs">Valor do desconto</span></div>
            <input type="number" name="discountValue" min="0"
              value="<%= seq.discountType === 'FIXED' ? (seq.discountValue / 100).toFixed(2) : seq.discountValue %>"
              step="<%= seq.discountType === 'FIXED' ? '0.01' : '1' %>" class="input input-bordered input-sm w-full" />
          </label>
        </div>

        <div class="label"><span class="label-text">Mensagem *</span></div>
        <div class="flex gap-1 mb-2">
          <button type="button" class="btn btn-xs btn-square btn-ghost" onclick="dgWrapSelection('message-<%= seq.id %>','&lt;b&gt;','&lt;/b&gt;')"><b>B</b></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" onclick="dgWrapSelection('message-<%= seq.id %>','&lt;i&gt;','&lt;/i&gt;')"><i>I</i></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" onclick="dgWrapSelection('message-<%= seq.id %>','&lt;u&gt;','&lt;/u&gt;')"><u>U</u></button>
        </div>
        <textarea id="message-<%= seq.id %>" name="message" rows="4" maxlength="4000" placeholder="Não conseguiu pagar? Temos uma oferta especial..." class="textarea textarea-bordered w-full"><%= seq.message %></textarea>
        <div class="flex gap-1.5 flex-wrap mt-2 mb-2">
          <% ["nome","saudacao","bot.username"].forEach(function(v) { %>
            <button type="button" class="badge badge-outline hover:badge-primary cursor-pointer" onclick="dgInsertAtCursor('message-<%= seq.id %>', '{<%= v %>}')">{<%= v %>}</button>
          <% }); %>
        </div>

        <div><button class="btn btn-sm btn-primary" type="submit">Salvar sequência</button></div>
      </form>

      <div class="text-xs uppercase tracking-wider text-base-content/40 mt-4 mb-1">
        Planos da Oferta
        <span class="text-base-content/40 normal-case">— exibidos com <%= seq.discountType === "PERCENT" ? seq.discountValue + "%" : formatBRL(seq.discountValue) %> de desconto</span>
      </div>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead><tr><th>Nome</th><th>Preço original</th><th>Com desconto</th><th></th></tr></thead>
          <tbody>
            <% seq.plans.forEach(function(link) { %>
              <tr>
                <td><%= link.plan.name %></td>
                <td><%= formatBRL(link.plan.priceCents) %></td>
                <td><%= formatBRL(applyDiscount(link.plan.priceCents, seq.discountType, seq.discountValue)) %></td>
                <td>
                  <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>/plans/<%= link.id %>/delete" class="inline">
                    <button class="btn btn-xs btn-error btn-outline" type="submit">Remover</button>
                  </form>
                </td>
              </tr>
            <% }); %>
            <% if (seq.plans.length === 0) { %><tr><td colspan="4" class="text-base-content/50 py-2">Nenhum plano cadastrado nesta oferta.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences/<%= seq.id %>/plans" class="flex gap-2 items-center flex-wrap mt-2">
        <select name="planId" class="select select-bordered select-sm flex-1 min-w-[160px]">
          <% flow.plans.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.name %> — <%= formatBRL(p.priceCents) %></option>
          <% }); %>
        </select>
        <button class="btn btn-sm btn-outline" type="submit">+ Anexar plano</button>
      </form>
    </div>
  </div>
<% }); %>

<% if (sequences.length === 0) { %>
  <p class="text-base-content/50 mb-4">Nenhuma sequência cadastrada nesta aba ainda.</p>
<% } %>

<% if (sequences.length < 20) { %>
  <form method="POST" action="/admin/flows/<%= flow.id %>/downsell/sequences">
    <input type="hidden" name="trigger" value="<%= activeTab === 'pix' ? 'PIX_GENERATED' : 'GENERAL' %>" />
    <button class="btn btn-outline" type="submit">+ Adicionar Sequência</button>
  </form>
<% } %>

  </div>
</div>
<%- include("../partials/footer", { active: "flows" }) %>
