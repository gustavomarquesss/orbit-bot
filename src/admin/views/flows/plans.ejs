<% const isEdit = !!editingPlan; %>
<%- include("../partials/header", { title: flow.name + " — Planos", active: "flows" }) %>
<%- include("./partials/nav", { flow, section: "plans" }) %>

<div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
  <div class="card-body">
    <h3 class="font-semibold mb-2">Planos</h3>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr><th>Nome</th><th>Preço</th><th>Duração</th><th>Entrega</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% flow.plans.forEach(function(p) { %>
            <tr>
              <td><%= p.name %></td>
              <td><%= formatBRL(p.priceCents) %></td>
              <td><%= p.durationDays ? p.durationDays + " dias" : "Pagamento único" %></td>
              <td><%= !p.deliveryType ? "Padrão do fluxo" : p.deliveryType === "FILE" ? "Arquivo" : p.deliveryType === "CHANNEL" ? "Canal VIP" : "Link" %></td>
              <td><% if (p.active) { %><span class="badge badge-success badge-sm">ativo</span><% } else { %><span class="badge badge-ghost badge-sm">inativo</span><% } %></td>
              <td class="flex gap-1.5">
                <a class="btn btn-xs btn-outline" href="/admin/flows/<%= flow.id %>/plans/<%= p.id %>/edit">Editar</a>
                <form method="POST" action="/admin/flows/<%= flow.id %>/plans/<%= p.id %>/delete" class="inline" onsubmit="return confirm('Excluir este plano?');">
                  <button class="btn btn-xs btn-error btn-outline" type="submit">Excluir</button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (flow.plans.length === 0) { %><tr><td colspan="6" class="text-base-content/50 py-4">Nenhum plano cadastrado ainda.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm">
  <div class="card-body">
    <h3 class="font-semibold mb-2"><%= isEdit ? "Editar plano" : "Novo plano" %></h3>
    <% if (error) { %><div class="alert alert-error text-sm mb-3"><%= error %></div><% } %>
    <% if (typeof fileError !== "undefined" && fileError) { %><div class="alert alert-error text-sm mb-3"><%= fileError %></div><% } %>
    <form method="POST" action="<%= isEdit ? `/admin/flows/${flow.id}/plans/${editingPlan.id}` : `/admin/flows/${flow.id}/plans` %>" class="flex flex-col gap-4">
      <label class="form-control">
        <div class="label"><span class="label-text">Nome</span></div>
        <input type="text" name="name" required value="<%= editingPlan ? editingPlan.name : "" %>" placeholder="Plano Mensal" class="input input-bordered w-full" />
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Preço (R$)</span></div>
        <input type="text" name="price" required inputmode="decimal" placeholder="29,90"
          value="<%= editingPlan ? (editingPlan.priceCents / 100).toFixed(2).replace('.', ',') : "" %>" class="input input-bordered w-full" />
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Duração em dias (deixe vazio para pagamento único/vitalício)</span></div>
        <input type="number" name="durationDays" min="1" value="<%= editingPlan && editingPlan.durationDays ? editingPlan.durationDays : "" %>" placeholder="30" class="input input-bordered w-full max-w-xs" />
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Cor do botão</span></div>
        <select name="buttonColor" class="select select-bordered w-full max-w-xs">
          <% ["PADRAO","AZUL","VERDE","VERMELHO"].forEach(function(c) { %>
            <option value="<%= c %>" <%= editingPlan && editingPlan.buttonColor === c ? "selected" : "" %>><%= c %></option>
          <% }); %>
        </select>
        <div class="label"><span class="label-text-alt text-base-content/60">Só tem efeito visual em contas com Telegram Business Premium — limitação da própria Bot API, não do painel.</span></div>
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Tipo de entrega</span></div>
        <select id="deliveryType" name="deliveryType" class="select select-bordered w-full" onchange="
          document.getElementById('default-fields-note').style.display = this.value === '' ? 'block' : 'none';
          document.getElementById('file-fields').style.display = this.value === 'FILE' ? 'block' : 'none';
          document.getElementById('link-fields').style.display = this.value === 'LINK' ? 'block' : 'none';
          document.getElementById('channel-fields').style.display = this.value === 'CHANNEL' ? 'block' : 'none';
          document.getElementById('custom-target-field').style.display = this.value === '' ? 'none' : 'block';
        ">
          <option value="" <%= !editingPlan || !editingPlan.deliveryType ? "selected" : "" %>>Usar padrão do fluxo</option>
          <option value="LINK" <%= editingPlan && editingPlan.deliveryType === "LINK" ? "selected" : "" %>>Link externo</option>
          <option value="FILE" <%= editingPlan && editingPlan.deliveryType === "FILE" ? "selected" : "" %>>Arquivo</option>
          <option value="CHANNEL" <%= editingPlan && editingPlan.deliveryType === "CHANNEL" ? "selected" : "" %>>Canal/grupo VIP (assinatura)</option>
        </select>
      </label>

      <p id="default-fields-note" class="text-sm text-base-content/60 -mt-2" style="display: <%= !editingPlan || !editingPlan.deliveryType ? "block" : "none" %>;">
        Este plano vai usar a <a class="link" href="/admin/flows/<%= flow.id %>/delivery">Entrega Padrão do fluxo</a>.
      </p>

      <div id="file-fields" style="display: <%= editingPlan && editingPlan.deliveryType === 'FILE' ? 'block' : 'none' %>;">
        <div class="label px-0"><span class="label-text">Arquivo entregue</span></div>
        <% if (editingPlan && editingPlan.fileTelegramId) { %>
          <p class="text-sm text-success mb-2">✓ Arquivo enviado (mensagem <%= editingPlan.fileTelegramId %>).</p>
        <% } else { %>
          <p class="text-sm text-base-content/50 mb-2">Nenhum arquivo próprio enviado ainda.</p>
        <% } %>
        <% if (isEdit) { %>
          <%- include("../partials/mediaUploadWidget", { id: "planFile", uploadUrl: `/admin/flows/${flow.id}/plans/${editingPlan.id}/file/upload` }) %>
        <% } else { %>
          <p class="text-sm text-base-content/50">Salve o plano primeiro (com "Arquivo" selecionado) — depois edite pra enviar o arquivo.</p>
        <% } %>
      </div>
      <div id="link-fields" style="display: <%= editingPlan && editingPlan.deliveryType === 'LINK' ? 'block' : 'none' %>;">
        <label class="form-control">
          <div class="label"><span class="label-text">Link a enviar após o pagamento</span></div>
          <input type="text" name="externalLink" value="<%= editingPlan && editingPlan.externalLink ? editingPlan.externalLink : "" %>" placeholder="https://..." class="input input-bordered w-full" />
        </label>
      </div>
      <div id="channel-fields" style="display: <%= editingPlan && editingPlan.deliveryType === 'CHANNEL' ? 'block' : 'none' %>;">
        <label class="form-control">
          <div class="label"><span class="label-text">ID do canal/grupo VIP</span></div>
          <input type="text" name="subscriptionChannelId" value="<%= editingPlan && editingPlan.subscriptionChannelId ? editingPlan.subscriptionChannelId : "" %>" placeholder="-1001234567890" class="input input-bordered w-full" />
          <div class="label"><span class="label-text-alt text-base-content/60">O bot precisa ser admin desse canal/grupo com permissão de convidar e remover membros. Cada compra gera um convite de uso único; se o plano tiver duração, o assinante é removido automaticamente quando expirar (sem renovar).</span></div>
        </label>
      </div>

      <div id="custom-target-field" style="display: <%= editingPlan && editingPlan.deliveryType ? "block" : "none" %>;">
        <label class="form-control">
          <div class="label"><span class="label-text">Canal/grupo de entrega específico deste plano (opcional)</span></div>
          <input type="text" name="customDeliveryTarget" value="<%= editingPlan && editingPlan.customDeliveryTarget ? editingPlan.customDeliveryTarget : "" %>" placeholder="deixe vazio pra usar a Entrega Padrão do fluxo" class="input input-bordered w-full" />
        </label>
      </div>

      <label class="label cursor-pointer justify-start gap-3 px-0">
        <input type="checkbox" name="protectContent" <%= !editingPlan || editingPlan.protectContent ? "checked" : "" %> class="checkbox checkbox-primary checkbox-sm" />
        <span class="label-text">Proteger conteúdo (impede reenvio/download)</span>
      </label>
      <label class="label cursor-pointer justify-start gap-3 px-0">
        <input type="checkbox" name="active" <%= !editingPlan || editingPlan.active ? "checked" : "" %> class="checkbox checkbox-primary checkbox-sm" />
        <span class="label-text">Plano ativo</span>
      </label>

      <div class="flex gap-2">
        <button class="btn btn-primary" type="submit">Salvar</button>
        <% if (isEdit) { %><a class="btn btn-ghost" href="/admin/flows/<%= flow.id %>/plans">Cancelar</a><% } %>
      </div>
    </form>
  </div>
</div>

  </div>
</div>
<%- include("../partials/footer", { active: "flows" }) %>
