<% const pm = flow.paymentMessages || {}; %>
<%- include("../partials/header", { title: flow.name + " — Pagamentos", active: "flows" }) %>
<%- include("./partials/nav", { flow, section: "payments" }) %>

<style>
  .payments-grid { display:grid; grid-template-columns: 1fr 300px; gap:20px; align-items:start; }
  @media (max-width: 780px) { .payments-grid { grid-template-columns: 1fr; } }
  .tg-preview { background:#0e1621; border-radius:14px; padding:14px; }
  .tg-preview .tg-bubble {
    background:#182533; color:#e9edf1; border-radius:10px 10px 10px 2px;
    padding:8px 10px; font-size:0.85rem; line-height:1.4; max-width:100%;
    word-wrap:break-word; margin-bottom:8px; white-space:pre-wrap;
  }
  .tg-preview .tg-label { color:#7d8b99; font-size:0.72rem; margin:10px 0 4px; text-transform:uppercase; letter-spacing:.04em; }
</style>

<div class="payments-grid">
  <div>
    <section>
      <h2>Pagamento gerado</h2>
      <form method="POST" action="/admin/flows/<%= flow.id %>/payments" id="payments-form">
        <label for="pixGeneratedMessage">Mensagem enviada junto com o código PIX</label>
        <div class="rte-toolbar">
          <button type="button" onclick="dgWrapSelection('pixGeneratedMessage','&lt;b&gt;','&lt;/b&gt;')"><b>B</b></button>
          <button type="button" onclick="dgWrapSelection('pixGeneratedMessage','&lt;i&gt;','&lt;/i&gt;')"><i>I</i></button>
          <button type="button" onclick="dgWrapSelection('pixGeneratedMessage','&lt;u&gt;','&lt;/u&gt;')"><u>U</u></button>
          <button type="button" onclick="dgWrapSelection('pixGeneratedMessage','&lt;code&gt;','&lt;/code&gt;')">&lt;/&gt;</button>
        </div>
        <textarea id="pixGeneratedMessage" name="pixGeneratedMessage" rows="5" oninput="dgUpdatePreview()"><%= pm.pixGeneratedMessage || "" %></textarea>
        <div class="var-chips">
          <% ["nome","valor","plano","saudacao","bot.username"].forEach(function(v) { %>
            <button type="button" onclick="dgInsertAtCursor('pixGeneratedMessage', '{<%= v %>}'); dgUpdatePreview();">{<%= v %>}</button>
          <% }); %>
        </div>
        <div class="hint">O código PIX copia-e-cola sempre vai numa mensagem própria logo depois desta, garantido — mesmo que você não referencie {valor}/etc aqui.</div>

        <label for="pixApprovedMessage" style="margin-top:22px;">Mensagem quando o pagamento é aprovado</label>
        <textarea id="pixApprovedMessage" name="pixApprovedMessage" rows="4"><%= pm.pixApprovedMessage || "" %></textarea>
        <div class="var-chips">
          <% ["nome","valor","plano","saudacao","bot.username"].forEach(function(v) { %>
            <button type="button" onclick="dgInsertAtCursor('pixApprovedMessage', '{<%= v %>}')">{<%= v %>}</button>
          <% }); %>
        </div>
        <div class="hint">Se deixar vazio, nenhuma mensagem extra é enviada — só a entrega do conteúdo já confirma o pagamento.</div>

        <label for="buttonStyle" style="margin-top:22px;">Estilo dos botões</label>
        <select id="buttonStyle" name="buttonStyle">
          <option value="PADRAO" <%= pm.buttonStyle === "PADRAO" || !pm.buttonStyle ? "selected" : "" %>>Padrão</option>
          <option value="COMPACTO" <%= pm.buttonStyle === "COMPACTO" ? "selected" : "" %>>Compacto</option>
        </select>

        <div class="checkbox-row">
          <input type="checkbox" id="showConfirmationStep" name="showConfirmationStep" <%= pm.showConfirmationStep ? "checked" : "" %> />
          <label for="showConfirmationStep">Mostrar tela de confirmação antes de gerar o PIX</label>
        </div>

        <div class="actions"><button class="btn" type="submit">Salvar mensagens</button></div>
      </form>
    </section>
  </div>

  <div class="tg-preview">
    <div class="tg-label">Preview (dados de exemplo)</div>
    <div class="tg-bubble" id="preview-generated">Pagamento gerado! Copie o código PIX abaixo e cole no app do seu banco:</div>
    <div class="tg-bubble" style="color:#8ab4f8;">00020126850014br.gov.bcb.pix...</div>
    <div class="tg-label">Ao aprovar</div>
    <div class="tg-bubble" id="preview-approved">(nenhuma mensagem extra configurada)</div>
  </div>
</div>

<script>
  // Substitui as variáveis por dados de exemplo; o resultado ainda contém as
  // tags HTML restritas do Telegram (<b>/<i>/etc), que o innerHTML abaixo
  // renderiza de propósito — é assim que ficaria de verdade no chat.
  function dgFakeRender(tpl) {
    const vars = { nome: "Fulano", valor: "R$ 29,90", plano: "Plano Mensal", saudacao: "Boa tarde", "bot.username": "<%= flow.bots[0] ? flow.bots[0].bot.telegramUsername : "seu_bot" %>" };
    return tpl.replace(/\{([a-zA-Z0-9_.]+)\}/g, function (m, key) { return key in vars ? vars[key] : m; });
  }
  function dgUpdatePreview() {
    const gen = document.getElementById("pixGeneratedMessage").value || "Pagamento gerado! Copie o código PIX abaixo e cole no app do seu banco:";
    const appr = document.getElementById("pixApprovedMessage").value;
    document.getElementById("preview-generated").innerHTML = dgFakeRender(gen);
    document.getElementById("preview-approved").innerHTML = appr ? dgFakeRender(appr) : "(nenhuma mensagem extra configurada)";
  }
  document.getElementById("pixApprovedMessage").addEventListener("input", dgUpdatePreview);
  dgUpdatePreview();
</script>

  </div>
</div>
<%- include("../partials/footer") %>
