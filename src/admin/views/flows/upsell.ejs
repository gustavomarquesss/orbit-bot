<%- include("../partials/header", { title: flow.name + " — Upsell", active: "flows" }) %>
<%- include("./partials/nav", { flow, section: "upsell" }) %>

<div class="alert alert-warning text-sm mb-6 py-2.5"><%- icon("exclamation-triangle", "w-4 h-4 shrink-0") %> O Upsell é enviado automaticamente após qualquer compra realizada no bot.</div>

<form method="POST" action="/admin/flows/<%= flow.id %>/upsell" class="mb-6">
  <label class="label cursor-pointer justify-start gap-3 px-0 w-fit">
    <input type="checkbox" name="active" onchange="this.form.submit()" <%= sequence.active ? "checked" : "" %> class="checkbox checkbox-primary checkbox-sm" />
    <span class="label-text">Upsell ativo</span>
  </label>
</form>

<% sequence.messages.forEach(function(m, idx) { %>
  <div class="card bg-base-200 border border-base-300 shadow-sm mb-4">
    <div class="card-body">
      <h3 class="font-semibold mb-3">Mensagem <%= idx + 1 %></h3>

      <form method="POST" action="/admin/flows/<%= flow.id %>/upsell/messages/<%= m.id %>" class="flex flex-col gap-1">
        <div class="label"><span class="label-text">Texto</span></div>
        <%- include("../partials/richEditor", { id: "text-" + m.id, name: "text", value: m.text, rows: 4, placeholder: "Exemplo de mensagem de upsell..." }) %>

        <label class="form-control max-w-xs">
          <div class="label"><span class="label-text">Tempo (minutos após a compra — 0 = imediato)</span></div>
          <input type="number" name="delayMinutes" min="0" value="<%= m.delayMinutes %>" class="input input-bordered input-sm w-full" />
        </label>

        <div class="mt-2"><button class="btn btn-sm btn-primary" type="submit">Salvar mensagem</button></div>
      </form>
      <form method="POST" action="/admin/flows/<%= flow.id %>/upsell/messages/<%= m.id %>/delete" class="inline" onsubmit="return confirm('Excluir esta mensagem inteira (planos e botões junto)?');">
        <button class="btn btn-sm btn-error btn-outline mt-2" type="submit">Excluir mensagem</button>
      </form>

      <div class="text-xs uppercase tracking-wider text-base-content/40 mt-4 mb-1">Planos anexados</div>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead><tr><th>Nome</th><th>Valor</th><th>Duração</th><th></th></tr></thead>
          <tbody>
            <% m.plans.forEach(function(link) { %>
              <tr>
                <td><%= link.plan.name %></td>
                <td><%= formatBRL(link.plan.priceCents) %></td>
                <td><%= link.plan.durationDays ? link.plan.durationDays + " dias" : "Avulso" %></td>
                <td>
                  <form method="POST" action="/admin/flows/<%= flow.id %>/upsell/messages/<%= m.id %>/plans/<%= link.id %>/delete" class="inline">
                    <button class="btn btn-xs btn-error btn-outline" type="submit">Remover</button>
                  </form>
                </td>
              </tr>
            <% }); %>
            <% if (m.plans.length === 0) { %><tr><td colspan="4" class="text-base-content/50 py-2">Nenhum plano anexado.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/flows/<%= flow.id %>/upsell/messages/<%= m.id %>/plans" class="flex gap-2 items-center flex-wrap mt-2">
        <select name="planId" class="select select-bordered select-sm flex-1 min-w-[160px]">
          <% flow.plans.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.name %> — <%= formatBRL(p.priceCents) %></option>
          <% }); %>
        </select>
        <button class="btn btn-sm btn-outline" type="submit">+ Anexar plano</button>
      </form>

      <div class="text-xs uppercase tracking-wider text-base-content/40 mt-4 mb-1">Botões</div>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead><tr><th>Texto</th><th>Tipo</th><th>Alvo</th><th></th></tr></thead>
          <tbody>
            <% m.buttons.forEach(function(b) { %>
              <tr>
                <td><%= b.text %></td>
                <td><%= b.type === "BUY_PLAN" ? "Comprar plano" : "Abrir link" %></td>
                <td><%= b.type === "BUY_PLAN" ? (b.targetPlan ? b.targetPlan.name : "—") : b.url %></td>
                <td>
                  <form method="POST" action="/admin/flows/<%= flow.id %>/upsell/messages/<%= m.id %>/buttons/<%= b.id %>/delete" class="inline">
                    <button class="btn btn-xs btn-error btn-outline" type="submit">Remover</button>
                  </form>
                </td>
              </tr>
            <% }); %>
            <% if (m.buttons.length === 0) { %><tr><td colspan="4" class="text-base-content/50 py-2">Nenhum botão cadastrado.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/flows/<%= flow.id %>/upsell/messages/<%= m.id %>/buttons" class="flex gap-2 items-center flex-wrap mt-2">
        <input type="text" id="btnText-<%= m.id %>" name="text" placeholder="Texto do botão" required class="input input-bordered input-sm flex-1 min-w-[140px]" />
        <button type="button" class="btn btn-outline btn-sm" title="Cor do botão" onclick="dgOpenColorModal('btnText-<%= m.id %>')"><%- icon("paint-brush", "w-4 h-4") %></button>
        <select name="type" class="select select-bordered select-sm" onchange="
          this.closest('form').querySelector('.btn-target-plan').style.display = this.value === 'BUY_PLAN' ? '' : 'none';
          this.closest('form').querySelector('.btn-target-url').style.display = this.value === 'OPEN_LINK' ? '' : 'none';
        ">
          <option value="BUY_PLAN">Comprar plano</option>
          <option value="OPEN_LINK">Abrir link</option>
        </select>
        <select name="targetPlanId" class="btn-target-plan select select-bordered select-sm">
          <% m.plans.forEach(function(link) { %>
            <option value="<%= link.plan.id %>"><%= link.plan.name %></option>
          <% }); %>
        </select>
        <input type="text" name="url" class="btn-target-url input input-bordered input-sm" placeholder="https://..." style="display:none;" />
        <button class="btn btn-sm btn-outline" type="submit">+ Adicionar botão</button>
      </form>
      <% if (m.plans.length === 0) { %>
        <p class="text-xs text-base-content/50 mt-2">Anexe pelo menos um plano acima pra poder criar um botão "Comprar plano".</p>
      <% } %>
    </div>
  </div>
<% }); %>

<form method="POST" action="/admin/flows/<%= flow.id %>/upsell/messages">
  <button class="btn btn-outline" type="submit">+ Adicionar Nova Mensagem</button>
</form>

  </div>
</div>
<%- include("../partials/footer", { active: "flows" }) %>
