<%- include("../partials/header", { title: "Fluxos", active: "flows" }) %>

<div class="actions" style="margin-bottom: 20px;">
  <a class="btn" href="/admin/flows/new">+ Novo fluxo</a>
</div>

<section>
  <h2>Fluxos configurados</h2>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Chave</th>
        <th>Passos</th>
        <th>Entrada (/start)</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% flows.forEach(function(f) { %>
        <tr>
          <td><a href="/admin/flows/<%= f.id %>" style="color:#4f7dfb;text-decoration:none;"><%= f.name %></a></td>
          <td><code><%= f.key %></code></td>
          <td><%= f._count.steps %></td>
          <td><% if (f.isEntryPoint) { %><span class="badge entry">sim</span><% } else { %>—<% } %></td>
          <td><a class="btn small secondary" href="/admin/flows/<%= f.id %>">Editar</a></td>
        </tr>
      <% }); %>
      <% if (flows.length === 0) { %>
        <tr><td colspan="5" class="empty">Nenhum fluxo cadastrado ainda.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include("../partials/footer") %>
