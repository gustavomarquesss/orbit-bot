<% const d = flow.delivery || {}; %>
<%- include("../partials/header", { title: flow.name + " — Entrega Padrão", active: "flows" }) %>
<%- include("./partials/nav", { flow, section: "delivery" }) %>

<% if (deliveryError) { %><div class="alert alert-error text-sm mb-4"><%= deliveryError %></div><% } %>

<div class="card bg-base-200 border border-base-300 shadow-sm">
  <div class="card-body">
    <h3 class="font-semibold mb-1">Entrega Padrão (Fallback)</h3>
    <p class="text-sm text-base-content/60 mb-4">Usada quando o plano está em "Usar padrão do fluxo" (a opção default ao criar um Plano novo) — assim você não precisa configurar arquivo/link em todo Plano, um só já cobre todos.</p>

    <form method="POST" action="/admin/flows/<%= flow.id %>/delivery" class="flex flex-col gap-4">
      <label class="form-control">
        <div class="label"><span class="label-text">Tipo de entrega</span></div>
        <select id="deliveryType" name="deliveryType" class="select select-bordered w-full max-w-xs" onchange="
          document.getElementById('delivery-file-fields').style.display = this.value === 'FILE' ? 'block' : 'none';
          document.getElementById('delivery-link-fields').style.display = this.value === 'LINK' ? 'block' : 'none';
        ">
          <option value="FILE" <%= !d.deliveryType || d.deliveryType === "FILE" ? "selected" : "" %>>Arquivo</option>
          <option value="LINK" <%= d.deliveryType === "LINK" ? "selected" : "" %>>Link externo</option>
        </select>
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Destino da Entrega (canal/grupo do Telegram)</span></div>
        <input type="text" name="deliveryTarget" value="<%= d.deliveryTarget || "" %>" placeholder="-1001234567890" class="input input-bordered w-full" />
        <div class="label"><span class="label-text-alt text-base-content/60">O bot precisa ser membro desse canal/grupo. Salve aqui antes de enviar o arquivo abaixo.</span></div>
      </label>

      <div id="delivery-link-fields" style="display: <%= d.deliveryType === "LINK" ? "block" : "none" %>;">
        <label class="form-control">
          <div class="label"><span class="label-text">Link a enviar após o pagamento</span></div>
          <input type="text" name="externalLink" value="<%= d.externalLink || "" %>" placeholder="https://..." class="input input-bordered w-full" />
        </label>
      </div>

      <div><button class="btn btn-primary" type="submit">Salvar</button></div>
    </form>

    <div id="delivery-file-fields" class="mt-4 pt-4 border-t border-base-300" style="display: <%= !d.deliveryType || d.deliveryType === "FILE" ? "block" : "none" %>;">
      <div class="label px-0"><span class="label-text">Arquivo entregue</span></div>
      <% if (d.fileTelegramId) { %>
        <p class="text-sm text-success mb-2">✓ Arquivo enviado (mensagem <%= d.fileTelegramId %> no canal configurado).</p>
      <% } else { %>
        <p class="text-sm text-base-content/50 mb-2">Nenhum arquivo enviado ainda.</p>
      <% } %>
      <% if (d.deliveryTarget) { %>
        <%- include("../partials/mediaUploadWidget", { id: "flowDelivery", uploadUrl: "/admin/flows/" + flow.id + "/delivery/file/upload" }) %>
      <% } else { %>
        <p class="text-sm text-base-content/50">Preencha e salve o "Destino da Entrega" acima antes de enviar o arquivo.</p>
      <% } %>
    </div>
  </div>
</div>

  </div>
</div>
<%- include("../partials/footer", { active: "flows" }) %>
