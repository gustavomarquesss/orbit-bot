<%- include("../partials/header", { title: "Novo fluxo", active: "flows" }) %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
  <h2 class="text-xl font-bold">Novo fluxo</h2>
  <a class="btn btn-outline btn-sm" href="/admin/flows">&larr; Todos os fluxos</a>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm">
  <div class="card-body">
    <% if (error) { %><div class="alert alert-error text-sm mb-3"><%= error %></div><% } %>
    <form method="POST" action="/admin/flows" class="flex flex-col gap-4">
      <label class="form-control">
        <div class="label"><span class="label-text">Chave (identificador único, ex: <code>boas-vindas</code>)</span></div>
        <input type="text" name="key" required pattern="[a-z0-9\-]+" placeholder="boas-vindas" class="input input-bordered w-full" />
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Nome (só pra você identificar no painel)</span></div>
        <input type="text" name="name" required placeholder="Funil principal" class="input input-bordered w-full" />
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Descrição (opcional)</span></div>
        <textarea name="description" class="textarea textarea-bordered w-full" rows="3"></textarea>
      </label>

      <div class="flex gap-2 mt-2">
        <button class="btn btn-primary" type="submit">Criar fluxo</button>
        <a class="btn btn-ghost" href="/admin/flows">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<%- include("../partials/footer", { active: "flows" }) %>
