<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DG Bot — Login</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, system-ui, sans-serif;
      background: #0f1115;
      color: #e6e6e6;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 16px;
    }
    form {
      background: #1a1d24;
      padding: 32px;
      border-radius: 12px;
      width: 100%;
      max-width: 340px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    h1 { font-size: 1.1rem; margin: 0 0 20px; color: #fff; }
    input {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid #2c303a;
      background: #0f1115;
      color: #fff;
      font-size: 1rem;
      margin-bottom: 12px;
    }
    button {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: none;
      background: #4f7dfb;
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
    }
    button:hover { background: #3d68e0; }
    .error { color: #ff6b6b; font-size: 0.9rem; margin-bottom: 12px; }
  </style>
</head>
<body>
  <form method="POST" action="/admin/login">
    <h1>DG Bot — Painel Admin</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <input type="password" name="password" placeholder="Senha" autofocus required />
    <button type="submit">Entrar</button>
  </form>
</body>
</html>
