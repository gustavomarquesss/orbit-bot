<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Órbit Bot — Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/output.css" />
  <script>
    (function () {
      var saved = localStorage.getItem("dgbot-theme");
      var theme = saved === "light" || saved === "dark" ? saved : "dark";
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
</head>
<body class="min-h-screen flex items-center justify-center bg-base-100 text-base-content p-4 font-sans">
  <form
    method="POST"
    action="/admin/login"
    class="card w-full max-w-[340px] bg-base-200 p-8 shadow-xl"
  >
    <h1 class="text-lg font-semibold mb-5"><span class="text-base-content">Órbit</span> <span class="text-red-600 font-extrabold">Bot</span> — Painel Admin</h1>
    <% if (error) { %><div class="text-error text-sm mb-3"><%= error %></div><% } %>
    <input
      type="password"
      name="password"
      placeholder="Senha"
      autofocus
      required
      class="input input-bordered w-full mb-3"
    />
    <button type="submit" class="btn btn-primary w-full text-primary-content">Entrar</button>
  </form>
</body>
</html>
