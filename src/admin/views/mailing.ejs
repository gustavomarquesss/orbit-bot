<%- include("partials/header", { title: "Mailing", active: "mailing" }) %>

<h2 class="text-xl font-bold mb-1">Mailing</h2>
<p class="text-sm text-base-content/60 mb-6">Sem agendamento — envia na hora pro segmento escolhido. Atualize a página pra acompanhar o progresso.</p>

<div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
  <div class="card-body">
    <h3 class="font-semibold mb-2">Disparos</h3>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr><th>Bot</th><th>Segmento</th><th>Status</th><th>Progresso</th><th>Criado em</th></tr>
        </thead>
        <tbody>
          <% broadcasts.forEach(function(b) { %>
            <tr>
              <td><%= b.bot.label %></td>
              <td><span class="badge badge-outline badge-sm"><%= b.segment === "ALL" ? "Todos" : b.segment === "BUYERS" ? "Compradores" : "Não-compradores" %></span></td>
              <td>
                <span class="badge badge-sm <%= b.status === "SENDING" ? "badge-warning" : b.status === "DONE" ? "badge-success" : "badge-error" %>">
                  <%= b.status === "SENDING" ? "Enviando..." : b.status === "DONE" ? "Concluído" : "Falhou" %>
                </span>
              </td>
              <td><%= b.sentCount %> enviadas / <%= b.failedCount %> falharam <% if (b.totalRecipients) { %>(de <%= b.totalRecipients %>)<% } %></td>
              <td class="text-base-content/60"><%= b.createdAt.toLocaleString("pt-BR") %></td>
            </tr>
          <% }); %>
          <% if (broadcasts.length === 0) { %><tr><td colspan="5" class="text-base-content/50 py-4">Nenhum disparo ainda.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm">
  <div class="card-body">
    <h3 class="font-semibold mb-2">Novo disparo</h3>
    <% if (error) { %><div class="alert alert-error text-sm mb-3"><%= error %></div><% } %>
    <form method="POST" action="/admin/mailing" class="flex flex-col gap-4">
      <label class="form-control">
        <div class="label"><span class="label-text">Bot</span></div>
        <select name="botId" required class="select select-bordered w-full">
          <% bots.forEach(function(bot) { %>
            <option value="<%= bot.id %>"><%= bot.label %></option>
          <% }); %>
        </select>
        <% if (bots.length === 0) { %><div class="label"><span class="label-text-alt text-base-content/60">Cadastre um bot primeiro em "Bots".</span></div><% } %>
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Segmento</span></div>
        <select name="segment" class="select select-bordered w-full">
          <option value="ALL">Todos os leads</option>
          <option value="BUYERS">Só compradores (pelo menos 1 pagamento aprovado)</option>
          <option value="NON_BUYERS">Só não-compradores</option>
        </select>
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Mensagem</span></div>
        <div class="flex gap-1 mb-2">
          <button type="button" class="btn btn-xs btn-square btn-ghost" onclick="dgWrapSelection('message','&lt;b&gt;','&lt;/b&gt;')"><b>B</b></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" onclick="dgWrapSelection('message','&lt;i&gt;','&lt;/i&gt;')"><i>I</i></button>
          <button type="button" class="btn btn-xs btn-square btn-ghost" onclick="dgWrapSelection('message','&lt;u&gt;','&lt;/u&gt;')"><u>U</u></button>
        </div>
        <textarea id="message" name="message" rows="6" required placeholder="Oi {nome}, ..." class="textarea textarea-bordered w-full"></textarea>
        <div class="flex gap-1.5 flex-wrap mt-2">
          <% ["nome","saudacao","bot.username"].forEach(function(v) { %>
            <button type="button" class="badge badge-outline hover:badge-primary cursor-pointer" onclick="dgInsertAtCursor('message', '{<%= v %>}')">{<%= v %>}</button>
          <% }); %>
        </div>
      </label>

      <div>
        <button class="btn btn-primary" type="submit" onclick="return confirm('Enviar agora pro segmento escolhido? Não dá pra cancelar depois de começar.');">Enviar agora</button>
      </div>
    </form>
  </div>
</div>

<%- include("partials/footer", { active: "mailing" }) %>
