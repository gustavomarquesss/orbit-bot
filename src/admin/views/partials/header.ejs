<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DG Bot — <%= typeof title !== "undefined" ? title : "Admin" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/output.css" />
  <script>
    // Aplica o tema salvo ANTES do primeiro paint, pra nunca piscar o tema
    // errado (script inline síncrono no <head>, não um <script defer/async>).
    // Os nomes "dark"/"light" também são os temas DaisyUI configurados em
    // tailwind.config.js (daisyui.themes) — o mesmo atributo data-theme
    // pilota os dois sistemas ao mesmo tempo.
    (function () {
      var saved = localStorage.getItem("dgbot-theme");
      var theme = saved === "light" || saved === "dark" ? saved : "dark";
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
</head>
<body class="min-h-screen bg-base-100 text-base-content font-sans">
  <div class="drawer lg:drawer-open">
    <input id="app-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col min-h-screen">
      <div class="navbar bg-base-200 border-b border-base-300 lg:hidden sticky top-0 z-10">
        <div class="flex-none">
          <label for="app-drawer" class="btn btn-square btn-ghost" aria-label="Abrir menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
        </div>
        <div class="flex-1 font-semibold">DG Bot Admin</div>
      </div>

      <main class="flex-1 w-full">
        <div class="max-w-6xl mx-auto p-4 lg:p-8">
