<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DG Bot — <%= typeof title !== "undefined" ? title : "Admin" %></title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, system-ui, sans-serif;
      background: #0f1115;
      color: #e6e6e6;
      margin: 0;
      padding: 0 16px 60px;
    }
    .wrap { max-width: 1000px; margin: 0 auto; }
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
      flex-wrap: wrap;
      gap: 12px;
      border-bottom: 1px solid #1f232c;
      margin-bottom: 24px;
    }
    header h1 { font-size: 1.1rem; margin: 0; color: #fff; white-space: nowrap; }
    nav { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
    nav a {
      color: #aaa;
      text-decoration: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.9rem;
    }
    nav a:hover { background: #1a1d24; color: #fff; }
    nav a.active { background: #4f7dfb22; color: #4f7dfb; }
    form.logout { display: inline; }
    form.logout button {
      background: transparent;
      border: 1px solid #2c303a;
      color: #aaa;
      padding: 6px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    section, .card {
      background: #1a1d24;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 20px;
    }
    section h2 { font-size: 1rem; margin: 0 0 14px; color: #fff; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #2c303a; vertical-align: top; }
    th { color: #8a8f9c; font-weight: 500; }
    .empty { color: #8a8f9c; padding: 8px 0; }
    label { display: block; font-size: 0.85rem; color: #aaa; margin: 14px 0 6px; }
    label:first-child { margin-top: 0; }
    input[type="text"], input[type="number"], textarea, select {
      width: 100%;
      padding: 9px 11px;
      border-radius: 8px;
      border: 1px solid #2c303a;
      background: #0f1115;
      color: #fff;
      font-size: 0.95rem;
      font-family: inherit;
    }
    textarea { resize: vertical; min-height: 70px; }
    .checkbox-row { display: flex; align-items: center; gap: 8px; margin: 14px 0 6px; }
    .checkbox-row input { width: auto; }
    .checkbox-row label { margin: 0; }
    .btn {
      display: inline-block;
      padding: 9px 16px;
      border-radius: 8px;
      border: none;
      background: #4f7dfb;
      color: #fff;
      font-size: 0.9rem;
      cursor: pointer;
      text-decoration: none;
      font-family: inherit;
    }
    .btn:hover { background: #3d68e0; }
    .btn.secondary { background: transparent; border: 1px solid #2c303a; color: #ccc; }
    .btn.danger { background: transparent; border: 1px solid #7a2e2e; color: #f87171; }
    .btn.danger:hover { background: #7a2e2e33; }
    .btn.small { padding: 5px 10px; font-size: 0.8rem; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
    .row-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .badge { padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; background: #2c303a; color: #ccc; }
    .badge.entry { background: rgba(74,222,128,0.15); color: #4ade80; }
    .badge.inactive { background: rgba(148,163,184,0.15); color: #94a3b8; }
    .hint { color: #8a8f9c; font-size: 0.8rem; margin-top: 4px; }
    .step-block { border: 1px solid #2c303a; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
    .step-block h3 { margin: 0 0 10px; font-size: 0.95rem; color: #fff; }
    .button-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #22262f; font-size: 0.88rem; }
    .button-row:last-child { border-bottom: none; }
    .inline-form { display: inline; }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>DG Bot Admin</h1>
      <nav>
        <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/admin/flows" class="<%= active === 'flows' ? 'active' : '' %>">Fluxos</a>
        <a href="/admin/products" class="<%= active === 'products' ? 'active' : '' %>">Produtos</a>
        <form class="logout" method="POST" action="/admin/logout">
          <button type="submit">Sair</button>
        </form>
      </nav>
    </header>
