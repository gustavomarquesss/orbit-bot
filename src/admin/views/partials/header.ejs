<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DG Bot — <%= typeof title !== "undefined" ? title : "Admin" %></title>
  <script>
    // Aplica o tema salvo ANTES do primeiro paint, pra nunca piscar o tema
    // errado (script inline síncrono no <head>, não um <script defer/async>).
    (function () {
      var saved = localStorage.getItem("dgbot-theme");
      var theme = saved === "light" || saved === "dark" ? saved : "dark";
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <style>
    :root {
      --bg: #0f1115;
      --surface: #1a1d24;
      --surface-2: #0f1115;
      --text: #e6e6e6;
      --text-strong: #ffffff;
      --text-muted: #8a8f9c;
      --border: #2c303a;
      --border-soft: #22262f;
      --accent: #e11d48;
      --accent-hover: #be123c;
      --accent-soft: #e11d4822;
      --danger: #f87171;
      --danger-border: #7a2e2e;
      --danger-soft: #7a2e2e33;
    }
    :root[data-theme="light"] {
      --bg: #f5f5f7;
      --surface: #ffffff;
      --surface-2: #f0f0f2;
      --text: #24262b;
      --text-strong: #0f1115;
      --text-muted: #6b7280;
      --border: #dfe1e6;
      --border-soft: #e8e9ed;
      --accent: #e11d48;
      --accent-hover: #be123c;
      --accent-soft: #e11d4818;
      --danger: #dc2626;
      --danger-border: #f3aeae;
      --danger-soft: #fde8e8;
    }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 0 16px 60px;
    }
    .wrap { max-width: 1000px; margin: 0 auto; }
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
      flex-wrap: wrap;
      gap: 12px;
      border-bottom: 1px solid var(--border-soft);
      margin-bottom: 24px;
    }
    header h1 { font-size: 1.1rem; margin: 0; color: var(--text-strong); white-space: nowrap; }
    nav { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
    nav a {
      color: var(--text-muted);
      text-decoration: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.9rem;
    }
    nav a:hover { background: var(--surface); color: var(--text-strong); }
    nav a.active { background: var(--accent-soft); color: var(--accent); }
    .theme-toggle {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-muted);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.95rem;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .theme-toggle:hover { color: var(--text-strong); border-color: var(--text-muted); }
    form.logout { display: inline; }
    form.logout button {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 6px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    section, .card {
      background: var(--surface);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 20px;
    }
    section h2 { font-size: 1rem; margin: 0 0 14px; color: var(--text-strong); }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
    th { color: var(--text-muted); font-weight: 500; }
    .empty { color: var(--text-muted); padding: 8px 0; }
    label { display: block; font-size: 0.85rem; color: var(--text-muted); margin: 14px 0 6px; }
    label:first-child { margin-top: 0; }
    input[type="text"], input[type="number"], textarea, select {
      width: 100%;
      padding: 9px 11px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text-strong);
      font-size: 0.95rem;
      font-family: inherit;
    }
    textarea { resize: vertical; min-height: 70px; }
    .checkbox-row { display: flex; align-items: center; gap: 8px; margin: 14px 0 6px; }
    .checkbox-row input { width: auto; }
    .checkbox-row label { margin: 0; }
    .btn {
      display: inline-block;
      padding: 9px 16px;
      border-radius: 8px;
      border: none;
      background: var(--accent);
      color: #fff;
      font-size: 0.9rem;
      cursor: pointer;
      text-decoration: none;
      font-family: inherit;
    }
    .btn:hover { background: var(--accent-hover); }
    .btn.secondary { background: transparent; border: 1px solid var(--border); color: var(--text); }
    .btn.danger { background: transparent; border: 1px solid var(--danger-border); color: var(--danger); }
    .btn.danger:hover { background: var(--danger-soft); }
    .btn.small { padding: 5px 10px; font-size: 0.8rem; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
    .row-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .badge { padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; background: var(--border); color: var(--text); }
    .badge.entry { background: rgba(74,222,128,0.15); color: #4ade80; }
    .badge.inactive { background: rgba(148,163,184,0.15); color: #94a3b8; }
    .hint { color: var(--text-muted); font-size: 0.8rem; margin-top: 4px; }
    .step-block { border: 1px solid var(--border); border-radius: 10px; padding: 14px; margin-bottom: 14px; }
    .step-block h3 { margin: 0 0 10px; font-size: 0.95rem; color: var(--text-strong); }
    .button-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--border-soft); font-size: 0.88rem; }
    .button-row:last-child { border-bottom: none; }
    .inline-form { display: inline; }
    .rte-toolbar { display:flex; gap:4px; flex-wrap:wrap; margin-bottom:6px; }
    .rte-toolbar button {
      background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
      border-radius: 6px; width: 30px; height: 30px; cursor: pointer; font-size: 0.85rem;
    }
    .rte-toolbar button:hover { border-color: var(--accent); color: var(--accent); }
    .var-chips { display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; }
    .var-chips button {
      background: var(--surface-2); border: 1px dashed var(--border); color: var(--text-muted);
      border-radius: 999px; padding: 3px 10px; font-size: 0.78rem; cursor: pointer; font-family: inherit;
    }
    .var-chips button:hover { border-color: var(--accent); color: var(--accent); }
    .media-row { display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid var(--border-soft); font-size:0.88rem; }
    .media-row:last-child { border-bottom:none; }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>DG Bot Admin</h1>
      <nav>
        <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/admin/bots" class="<%= active === 'bots' ? 'active' : '' %>">Bots</a>
        <a href="/admin/flows" class="<%= active === 'flows' ? 'active' : '' %>">Fluxos</a>
        <button type="button" class="theme-toggle" id="theme-toggle" title="Alternar tema" aria-label="Alternar tema">🌓</button>
        <form class="logout" method="POST" action="/admin/logout">
          <button type="submit">Sair</button>
        </form>
      </nav>
    </header>
    <script>
      // Helpers reaproveitados pelos editores de texto rico (boas-vindas,
      // pagamentos): envolve a seleção do textarea com tags HTML, ou insere
      // uma variável {chip} na posição do cursor.
      function dgWrapSelection(id, open, close) {
        var ta = document.getElementById(id);
        var start = ta.selectionStart, end = ta.selectionEnd;
        var before = ta.value.slice(0, start), sel = ta.value.slice(start, end), after = ta.value.slice(end);
        ta.value = before + open + sel + close + after;
        ta.focus();
        ta.selectionStart = start + open.length;
        ta.selectionEnd = start + open.length + sel.length;
      }
      function dgInsertAtCursor(id, text) {
        var ta = document.getElementById(id);
        var start = ta.selectionStart, end = ta.selectionEnd;
        ta.value = ta.value.slice(0, start) + text + ta.value.slice(end);
        ta.focus();
        ta.selectionStart = ta.selectionEnd = start + text.length;
      }
      document.getElementById("theme-toggle").addEventListener("click", function () {
        var root = document.documentElement;
        var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
        root.setAttribute("data-theme", next);
        localStorage.setItem("dgbot-theme", next);
      });
    </script>
