<%- include("partials/header", { title: "Dashboard", active: "dashboard" }) %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>

<form method="GET" action="/admin" id="filters-form" class="flex flex-wrap gap-3 mb-6">
  <select name="botId" class="select select-bordered select-sm w-auto min-w-[160px]" onchange="document.getElementById('filters-form').submit()">
    <option value="">Todos os bots</option>
    <% bots.forEach(function(bot) { %>
      <option value="<%= bot.id %>" <%= selectedBotId === bot.id ? "selected" : "" %>><%= bot.label %></option>
    <% }); %>
  </select>
  <select name="period" class="select select-bordered select-sm w-auto min-w-[160px]" onchange="document.getElementById('filters-form').submit()">
    <option value="hoje" <%= selectedPeriod === "hoje" ? "selected" : "" %>>Hoje</option>
    <option value="ontem" <%= selectedPeriod === "ontem" ? "selected" : "" %>>Ontem</option>
    <option value="7d" <%= selectedPeriod === "7d" ? "selected" : "" %>>Últimos 7 dias</option>
    <option value="30d" <%= selectedPeriod === "30d" ? "selected" : "" %>>Últimos 30 dias</option>
    <option value="total" <%= selectedPeriod === "total" ? "selected" : "" %>>Total</option>
  </select>
</form>

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-6">
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Receita aprovada</div>
    <div class="text-2xl font-bold text-success"><%= formatBRL(revenueCents) %></div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Vendas aprovadas</div>
    <div class="text-2xl font-bold text-success"><%= approvedCount %></div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Ticket médio</div>
    <div class="text-2xl font-bold"><%= formatBRL(avgTicketCents) %></div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Tempo médio até pagar</div>
    <div class="text-2xl font-bold"><%= avgTimeLabel %></div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Starts (leads novos)</div>
    <div class="text-2xl font-bold"><%= startsCount %></div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Conversão de usuário</div>
    <div class="text-2xl font-bold"><%= userConversionRate.toFixed(1) %>%</div>
    <div class="text-xs text-base-content/40">compradores / leads novos</div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Conversão de pagamento</div>
    <div class="text-2xl font-bold"><%= paymentConversionRate.toFixed(1) %>%</div>
    <div class="text-xs text-base-content/40">pagos / PIX gerados</div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">PIX pendentes (no período)</div>
    <div class="text-2xl font-bold text-warning"><%= createdCounts.PENDING %></div>
  </div>
  <div class="card bg-base-200 border border-base-300 p-4">
    <div class="text-xs text-base-content/50 mb-1">Recusados/expirados (no período)</div>
    <div class="text-2xl font-bold text-error"><%= createdCounts.REFUSED + createdCounts.EXPIRED %></div>
  </div>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
  <div class="card-body">
    <h3 class="font-semibold mb-3">Cobranças por dia</h3>
    <canvas id="dailyChart" class="max-h-[220px]"></canvas>
  </div>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
  <div class="card-body">
    <h3 class="font-semibold mb-2">Ranking por Código de Venda <span class="text-base-content/40 font-normal text-sm">(top 5, receita do período)</span></h3>
    <div class="overflow-x-auto">
      <table class="table">
        <thead><tr><th>Código</th><th>Origem</th><th>Vendas</th><th>Receita</th></tr></thead>
        <tbody>
          <% originRanking.forEach(function(o) { %>
            <tr>
              <td><code class="text-xs bg-base-300/60 px-1.5 py-0.5 rounded"><%= o.param %></code></td>
              <td><%= o.label %></td>
              <td><%= o.count %></td>
              <td><%= formatBRL(o.revenueCents) %></td>
            </tr>
          <% }); %>
          <% if (originRanking.length === 0) { %>
            <tr><td colspan="4" class="text-base-content/50 py-4">Nenhuma venda aprovada no período.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card bg-base-200 border border-base-300 shadow-sm">
  <div class="card-body">
    <h3 class="font-semibold mb-1">Log de atividade</h3>
    <p class="text-sm text-base-content/60 mb-3">Últimos eventos, de todos os bots (ou só do bot filtrado acima) — não é limitado pelo período escolhido, é sempre o mais recente.</p>
    <div class="flex flex-col divide-y divide-base-300">
      <% activityLog.forEach(function(ev) { %>
        <div class="flex items-center justify-between gap-3 py-2.5 text-sm">
          <span class="flex items-center gap-2 min-w-0">
            <span class="shrink-0"><%- icon(ev.kind === "lead" ? "user-plus" : ev.kind === "pix" ? "credit-card" : "check-circle", "w-4 h-4") %></span>
            <span class="truncate"><%= ev.label %></span>
          </span>
          <span class="flex items-center gap-3 shrink-0">
            <span class="text-base-content/50 hidden sm:inline"><%= ev.sub %></span>
            <span class="text-base-content/40 text-xs whitespace-nowrap"><%= new Date(ev.at).toLocaleString("pt-BR") %></span>
          </span>
        </div>
      <% }); %>
      <% if (activityLog.length === 0) { %><p class="text-base-content/50 py-4">Nenhuma atividade ainda.</p><% } %>
    </div>
  </div>
</div>

<script>
  const dailyOrders = <%- JSON.stringify(dailyOrders) %>;
  const isDark = document.documentElement.getAttribute("data-theme") !== "light";
  const accentColor = isDark ? "#FF6B6B" : "#E11D33";
  const mutedColor = isDark ? "#A1A1AA" : "#71717A";
  new Chart(document.getElementById("dailyChart"), {
    type: "bar",
    data: {
      labels: dailyOrders.map(d => new Date(d.day).toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" })),
      datasets: [{
        label: "Cobranças",
        data: dailyOrders.map(d => d.count),
        backgroundColor: accentColor,
        borderRadius: 4,
      }],
    },
    options: {
      animation: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: mutedColor } },
        y: { beginAtZero: true, ticks: { color: mutedColor, precision: 0 } },
      },
    },
  });
</script>
<%- include("partials/footer", { active: "dashboard" }) %>
