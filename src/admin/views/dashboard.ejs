<%- include("partials/header", { title: "Dashboard", active: "dashboard" }) %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .card .label { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; }
  .card .value { font-size: 1.5rem; font-weight: 600; color: var(--text-strong); }
  .card.paid .value { color: #4ade80; }
  .card.pending .value { color: #facc15; }
  .card.refused .value { color: #f87171; }
  section { overflow-x: auto; }
  table { min-width: 560px; }
  td, th { white-space: nowrap; }
  .status { padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; }
  .status-PAID { background: rgba(74,222,128,0.15); color: #4ade80; }
  .status-PENDING { background: rgba(250,204,21,0.15); color: #facc15; }
  .status-REFUSED { background: rgba(248,113,113,0.15); color: #f87171; }
  .status-EXPIRED { background: rgba(148,163,184,0.15); color: #94a3b8; }
  canvas { max-height: 220px; }
</style>

<div class="stats">
  <div class="card paid">
    <div class="label">Receita aprovada</div>
    <div class="value"><%= formatBRL(revenueCents) %></div>
  </div>
  <div class="card paid">
    <div class="label">Vendas aprovadas</div>
    <div class="value"><%= counts.PAID %></div>
  </div>
  <div class="card pending">
    <div class="label">Pendentes</div>
    <div class="value"><%= counts.PENDING %></div>
  </div>
  <div class="card refused">
    <div class="label">Recusadas/expiradas</div>
    <div class="value"><%= counts.REFUSED + counts.EXPIRED %></div>
  </div>
  <div class="card">
    <div class="label">Leads</div>
    <div class="value"><%= leadCount %></div>
  </div>
  <div class="card">
    <div class="label">Taxa de conversão</div>
    <div class="value"><%= conversionRate.toFixed(1) %>%</div>
  </div>
</div>

<section>
  <h2>Cobranças por dia (últimos 14 dias)</h2>
  <canvas id="dailyChart"></canvas>
</section>

<section>
  <h2>Últimas cobranças</h2>
  <table>
    <thead>
      <tr>
        <th>Data</th>
        <th>Produto</th>
        <th>Lead</th>
        <th>Origem</th>
        <th>Valor</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% recentOrders.forEach(function(o) { %>
        <tr>
          <td><%= new Date(o.createdAt).toLocaleString("pt-BR") %></td>
          <td><%= o.items.map(function(i) { return i.plan.name; }).join(" + ") %></td>
          <td><%= o.lead.username ? "@" + o.lead.username : o.lead.firstName || o.leadId %></td>
          <td><%= o.origin ? o.origin.label : "—" %></td>
          <td><%= formatBRL(o.amountCents) %></td>
          <td><span class="status status-<%= o.status %>"><%= o.status %></span></td>
        </tr>
      <% }); %>
      <% if (recentOrders.length === 0) { %>
        <tr><td colspan="6" class="empty">Nenhuma cobrança registrada ainda.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<script>
  const dailyOrders = <%- JSON.stringify(dailyOrders) %>;
  const ctx = document.getElementById("dailyChart");
  const themeVar = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  new Chart(ctx, {
    type: "bar",
    data: {
      labels: dailyOrders.map(d => new Date(d.day).toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" })),
      datasets: [{
        label: "Cobranças",
        data: dailyOrders.map(d => d.count),
        backgroundColor: themeVar("--accent"),
        borderRadius: 4,
      }],
    },
    options: {
      animation: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: themeVar("--text-muted") } },
        y: { beginAtZero: true, ticks: { color: themeVar("--text-muted"), precision: 0 } },
      },
    },
  });
</script>
<%- include("partials/footer") %>
