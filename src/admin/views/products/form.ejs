<% const isEdit = product && product.id; %>
<%- include("../partials/header", { title: isEdit ? "Editar produto" : "Novo produto", active: "products" }) %>

<section>
  <h2><%= isEdit ? "Editar produto" : "Novo produto" %></h2>
  <% if (error) { %><p style="color:#f87171;"><%= error %></p><% } %>
  <form method="POST" action="<%= isEdit ? `/admin/products/${product.id}` : "/admin/products" %>">
    <label for="name">Nome</label>
    <input type="text" id="name" name="name" required value="<%= product ? product.name : "" %>" />

    <label for="description">Descrição (opcional)</label>
    <textarea id="description" name="description"><%= product && product.description ? product.description : "" %></textarea>

    <label for="price">Preço (R$)</label>
    <input type="text" id="price" name="price" required inputmode="decimal" placeholder="29,90"
      value="<%= product && product.priceCents ? (product.priceCents / 100).toFixed(2).replace('.', ',') : "" %>" />

    <label for="deliveryType">Tipo de entrega</label>
    <select id="deliveryType" name="deliveryType" onchange="document.getElementById('file-fields').style.display = this.value === 'FILE' ? 'block' : 'none'; document.getElementById('link-fields').style.display = this.value === 'LINK' ? 'block' : 'none';">
      <option value="LINK" <%= !product || product.deliveryType === "LINK" ? "selected" : "" %>>Link externo</option>
      <option value="FILE" <%= product && product.deliveryType === "FILE" ? "selected" : "" %>>Arquivo no canal-cofre</option>
    </select>

    <div id="file-fields" style="display: <%= product && product.deliveryType === 'FILE' ? 'block' : 'none' %>;">
      <label for="fileTelegramId">Número da mensagem (message_id) no canal-cofre</label>
      <input type="text" id="fileTelegramId" name="fileTelegramId" value="<%= product && product.fileTelegramId ? product.fileTelegramId : "" %>" placeholder="482" />
      <div class="hint">Poste o produto uma vez no canal <code>TELEGRAM_VAULT_CHANNEL_ID</code> e use o número da mensagem — não é o file_id. Ver README.</div>
    </div>

    <div id="link-fields" style="display: <%= !product || product.deliveryType === 'LINK' ? 'block' : 'none' %>;">
      <label for="externalLink">Link a enviar após o pagamento</label>
      <input type="text" id="externalLink" name="externalLink" value="<%= product && product.externalLink ? product.externalLink : "" %>" placeholder="https://..." />
    </div>

    <div class="checkbox-row">
      <input type="checkbox" id="protectContent" name="protectContent" <%= !product || product.protectContent ? "checked" : "" %> />
      <label for="protectContent">Proteger conteúdo (impede reenvio/download no Telegram)</label>
    </div>

    <div class="checkbox-row">
      <input type="checkbox" id="active" name="active" <%= !product || product.active ? "checked" : "" %> />
      <label for="active">Produto ativo (aparece disponível para compra)</label>
    </div>

    <div class="actions">
      <button class="btn" type="submit">Salvar</button>
      <a class="btn secondary" href="/admin/products">Cancelar</a>
    </div>
  </form>
</section>

<%- include("../partials/footer") %>
