<%- include("../partials/header", { title: "Produtos", active: "products" }) %>

<div class="actions" style="margin-bottom: 20px;">
  <a class="btn" href="/admin/products/new">+ Novo produto</a>
</div>

<section>
  <h2>Produtos cadastrados</h2>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Entrega</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function(p) { %>
        <tr>
          <td><%= p.name %></td>
          <td><%= formatBRL(p.priceCents) %></td>
          <td><%= p.deliveryType === "FILE" ? "Arquivo (canal-cofre)" : "Link" %></td>
          <td><% if (!p.active) { %><span class="badge inactive">inativo</span><% } else { %><span class="badge entry">ativo</span><% } %></td>
          <td class="row-actions">
            <a class="btn small secondary" href="/admin/products/<%= p.id %>/edit">Editar</a>
            <form method="POST" action="/admin/products/<%= p.id %>/delete" class="inline-form" onsubmit="return confirm('Excluir este produto?');">
              <button class="btn small danger" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (products.length === 0) { %>
        <tr><td colspan="5" class="empty">Nenhum produto cadastrado ainda.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include("../partials/footer") %>
