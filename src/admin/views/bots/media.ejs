<%- include("../partials/header", { title: bot.label + " — Mídia", active: "bots" }) %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-2">
  <h2 class="text-xl font-bold">Biblioteca de mídia — <%= bot.label %></h2>
  <a class="btn btn-outline btn-sm" href="/admin/bots/<%= bot.id %>/edit">&larr; Voltar pro bot</a>
</div>
<% if (error) { %><div class="alert alert-error text-sm mb-4"><%= error %></div><% } %>

<form method="POST" action="/admin/bots/<%= bot.id %>/media/upload" enctype="multipart/form-data" id="mediaUploadForm">
  <label for="mediaUploadInput" id="mediaDropZone" class="card bg-base-200 border-2 border-dashed border-base-300 shadow-sm cursor-pointer hover:border-primary/60 transition-colors block mb-2">
    <div class="card-body flex-row items-center gap-4 p-4">
      <div class="rounded-lg bg-base-300/60 p-3 pointer-events-none">
        <%- icon("arrow-up-tray", "w-5 h-5") %>
      </div>
      <div class="pointer-events-none">
        <div class="font-semibold">Adicionar arquivo</div>
        <div class="text-sm text-base-content/60">Clique ou arraste — foto, vídeo ou áudio (PNG, JPG, MP4, OGG)</div>
      </div>
    </div>
  </label>
  <input id="mediaUploadInput" type="file" name="file" accept="image/*,video/*,audio/*" class="hidden" onchange="document.getElementById('mediaUploadForm').submit()" />
</form>
<p class="text-xs text-base-content/50 mb-6">
  Para enviar mídias, configure o canal em <a class="link" href="/admin/settings">Configurações</a> e conceda a este bot as permissões necessárias no canal ou grupo.
</p>

<script>
  (function () {
    var zone = document.getElementById("mediaDropZone");
    var input = document.getElementById("mediaUploadInput");
    var form = document.getElementById("mediaUploadForm");
    zone.addEventListener("dragover", function (e) {
      e.preventDefault();
      zone.classList.add("border-primary");
    });
    ["dragleave", "drop"].forEach(function (evt) {
      zone.addEventListener(evt, function (e) {
        e.preventDefault();
        zone.classList.remove("border-primary");
      });
    });
    zone.addEventListener("drop", function (e) {
      if (e.dataTransfer.files.length > 0) {
        input.files = e.dataTransfer.files;
        form.submit();
      }
    });
  })();
</script>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% assets.forEach(function(a) { %>
    <div class="card bg-base-200 border border-base-300 shadow-sm">
      <div class="card-body p-4">
        <% if (a.mediaType === "PHOTO") { %>
          <img src="/admin/bots/<%= bot.id %>/media/<%= a.id %>/file" class="rounded-lg w-full h-40 object-cover mb-2" loading="lazy" />
        <% } else if (a.mediaType === "VIDEO") { %>
          <video src="/admin/bots/<%= bot.id %>/media/<%= a.id %>/file" controls class="rounded-lg w-full h-40 object-cover mb-2"></video>
        <% } else if (a.mediaType === "AUDIO") { %>
          <audio src="/admin/bots/<%= bot.id %>/media/<%= a.id %>/file" controls class="w-full mb-2"></audio>
        <% } else { %>
          <a href="/admin/bots/<%= bot.id %>/media/<%= a.id %>/file" target="_blank" class="btn btn-outline btn-sm w-full mb-2 gap-1.5"><%- icon("document", "w-4 h-4") %> Baixar documento</a>
        <% } %>
        <div class="badge badge-ghost badge-sm mb-1"><%= a.mediaType %></div>
        <p class="text-sm truncate" title="<%= a.label || "" %>"><%= a.label || "(sem legenda)" %></p>
        <p class="text-xs text-base-content/40 mb-2"><%= a.createdAt.toLocaleString("pt-BR") %></p>
        <div class="flex gap-1.5">
          <button type="button" class="btn btn-xs btn-outline flex-1" onclick="navigator.clipboard.writeText('<%= a.fileId %>'); this.textContent='Copiado!'; setTimeout(() => this.textContent='Copiar file_id', 1500);">Copiar file_id</button>
          <form method="POST" action="/admin/bots/<%= bot.id %>/media/<%= a.id %>/delete" onsubmit="return confirm('Remover esta mídia da biblioteca?');">
            <button class="btn btn-xs btn-error btn-outline" type="submit">Remover</button>
          </form>
        </div>
      </div>
    </div>
  <% }); %>
  <% if (assets.length === 0) { %>
    <p class="text-base-content/50 col-span-full py-6 text-center">Nenhuma mídia capturada ainda.</p>
  <% } %>
</div>

<%- include("../partials/footer", { active: "bots" }) %>
