<%- include("../partials/header", { title: bot.label, active: "bots" }) %>

<div class="flex items-center justify-between flex-wrap gap-3 mb-6">
  <h2 class="text-xl font-bold">
    <%= bot.label %>
    <span class="badge <%= live ? "badge-success" : "badge-ghost" %> ml-1"><%= live ? "online" : "offline" %></span>
  </h2>
  <a class="btn btn-outline btn-sm" href="/admin/bots">&larr; Todos os bots</a>
</div>
<p class="text-sm text-base-content/60 -mt-4 mb-6">@<%= bot.telegramUsername || "desconhecido" %></p>

<div class="flex flex-col gap-6">
  <div class="card bg-base-200 border border-base-300 shadow-sm">
    <div class="card-body">
      <h3 class="font-semibold mb-2">Perfil</h3>
      <form method="POST" action="/admin/bots/<%= bot.id %>" class="flex flex-col gap-4">
        <label class="form-control">
          <div class="label"><span class="label-text">Nome exibido no Telegram</span></div>
          <input type="text" name="displayName" value="<%= bot.displayName || "" %>" class="input input-bordered w-full" />
        </label>

        <label class="form-control">
          <div class="label"><span class="label-text">Descrição (aparece antes do /start)</span></div>
          <textarea name="description" class="textarea textarea-bordered w-full" rows="3"><%= bot.description || "" %></textarea>
        </label>

        <label class="form-control">
          <div class="label"><span class="label-text">Descrição curta (aparece no perfil do bot)</span></div>
          <textarea name="shortDescription" class="textarea textarea-bordered w-full" rows="2"><%= bot.shortDescription || "" %></textarea>
        </label>

        <div><button class="btn btn-primary" type="submit">Salvar perfil</button></div>
      </form>
    </div>
  </div>

  <div class="card bg-base-200 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
        <h3 class="font-semibold">Mídia</h3>
        <a class="btn btn-outline btn-sm gap-1.5" href="/admin/bots/<%= bot.id %>/media"><%- icon("folder", "w-4 h-4") %> Biblioteca de mídia</a>
      </div>
      <p class="text-sm text-base-content/60">
        Envie foto/vídeo/áudio/documento direto pela tela na biblioteca — usa
        o mesmo canal configurado em <a class="link" href="/admin/settings">Configurações → Canal de vendas</a>
        pra armazenar o arquivo no Telegram e capturar o file_id automaticamente.
      </p>
    </div>
  </div>

  <div class="card bg-base-200 border border-base-300 shadow-sm">
    <div class="card-body">
      <h3 class="font-semibold mb-1">Comandos do bot</h3>
      <p class="text-sm text-base-content/60 mb-3">Os comandos em si (/start, /suporte, /status) não mudam — só o emoji e o texto.</p>
      <form method="POST" action="/admin/bots/<%= bot.id %>/commands" class="flex flex-col gap-3">
        <% bot.commands.forEach(function(cmd) { %>
          <label class="form-control">
            <div class="label"><span class="label-text">/<%= cmd.kind.toLowerCase() %></span></div>
            <div class="flex gap-2">
              <input type="text" name="<%= cmd.kind %>_emoji" value="<%= cmd.emoji %>" maxlength="4" class="input input-bordered w-20" />
              <input type="text" name="<%= cmd.kind %>_label" value="<%= cmd.label %>" class="input input-bordered flex-1" />
            </div>
          </label>
        <% }); %>
        <div><button class="btn btn-primary" type="submit">Salvar comandos</button></div>
      </form>
    </div>
  </div>

  <div class="card bg-base-200 border border-error/30 shadow-sm">
    <div class="card-body">
      <form method="POST" action="/admin/bots/<%= bot.id %>/delete" onsubmit="return confirm('Excluir este bot? O webhook será removido do Telegram.');">
        <button class="btn btn-error btn-outline" type="submit">Excluir bot</button>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/footer", { active: "bots" }) %>
