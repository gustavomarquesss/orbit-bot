{
  "name": "dg-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de vendas Telegram (uso pessoal) com cobrança PIX via SyncPay",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,css -c blue,green \"npm:dev:server\" \"npm:dev:css\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:css": "tailwindcss -i src/public/css/input.css -o public/css/output.css --watch",
    "build": "tsc -p tsconfig.json && npm run build:css",
    "build:css": "tailwindcss -i src/public/css/input.css -o public/css/output.css --minify",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "daisyui": "^4.12.24",
    "postcss": "^8.5.26",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
