// Schema único — fonte da verdade do modelo de dados.
// Ver ARCHITECTURE.md e PROJECT_STATE.md para o racional de cada entidade.
// Modelo "funil de seções fixas" (Bot -> Flow -> Boas-vindas/Planos/
// Pagamentos), não um grafo genérico de passos — ver
// C:\Users\gusta\.claude\plans\rippling-rolling-castle.md para o porquê.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tabela do connect-pg-simple (session store do express-session, ver
/// src/admin/routes.ts) — a lib gerencia essa tabela em runtime, não o
/// Prisma Client. Declarada aqui só pra Prisma Migrate saber que ela existe
/// de propósito e não tentar dropar como "tabela não referenciada".
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

/// Linha única (id fixo "singleton") de configurações globais do painel —
/// hoje só o canal de vendas, mas o padrão fica pronto pra crescer sem
/// precisar de variável de ambiente nova a cada config (evita redeploy).
model Settings {
  id             String  @id @default("singleton")
  /// Canal/grupo do Telegram (id numérico, ex: "-1001234567890") que recebe
  /// a notificação de toda venda aprovada de todos os bots. Nulo = cai no
  /// fallback antigo (DM pro TELEGRAM_ADMIN_USER_ID).
  salesChannelId String?
}

/// Fonte de tráfego rastreável: outro bot, canal, campanha etc.
/// `param` é o valor usado no deep link t.me/seu_bot?start=param
model Origin {
  id        String   @id @default(cuid())
  param     String   @unique
  label     String
  kind      OriginKind @default(OTHER)
  createdAt DateTime @default(now())

  leads  Lead[]
  orders Order[]
}

enum OriginKind {
  BOT
  CHANNEL
  CAMPAIGN
  OTHER
}

/// Um bot do Telegram gerenciado pelo painel (substitui o antigo
/// TELEGRAM_BOT_TOKEN único no .env — agora dá pra ter vários).
model Bot {
  id                String   @id @default(cuid())
  label             String
  /// Token do BotFather, criptografado (AES-256-GCM via src/lib/crypto.ts).
  /// Nunca gravar em texto plano.
  telegramBotTokenEncrypted String
  telegramUsername  String?
  telegramUserId    BigInt?
  displayName       String?
  photoFileId       String?
  description       String?
  shortDescription  String?
  /// Usado no path do webhook (/telegram/webhook/:botId/:webhookSecret).
  webhookSecret     String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  commands BotCommand[]
  flows    FlowBot[]
  leads    Lead[]
  orders   Order[]
}

enum BotCommandKind {
  START
  SUPORTE
  STATUS
}

/// Comandos fixos do bot (/start, /suporte, /status) — só emoji e label
/// são editáveis, os comandos em si não mudam (igual ao Shark Bot).
model BotCommand {
  id     String         @id @default(cuid())
  botId  String
  bot    Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  kind   BotCommandKind
  emoji  String
  label  String
  order  Int

  @@unique([botId, kind])
}

/// Usuário do Telegram que já interagiu com um Bot específico. O mesmo
/// telegramId pode ser um Lead diferente em cada Bot (funis/vendas
/// separados por bot).
model Lead {
  id          String   @id @default(cuid())
  telegramId  BigInt
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  username    String?
  firstName   String?
  lastName    String?
  /// Código de idioma do cliente Telegram do usuário (ex: "pt-br", "en") —
  /// vem de ctx.from.language_code, exibido no canal de vendas rico.
  languageCode String?
  /// ctx.from.is_premium — exibido no canal de vendas rico.
  isPremium   Boolean  @default(false)
  originId    String?
  origin      Origin?  @relation(fields: [originId], references: [id])
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  orders Order[]

  @@unique([telegramId, botId])
}

/// Um funil de vendas (pode ser vinculado a múltiplos Bots via FlowBot).
model Flow {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bots            FlowBot[]
  welcomeConfig   WelcomeConfig?
  paymentMessages PaymentMessages?
  plans           Plan[]
}

/// "Bots Vinculados" de um Flow — quais bots executam este funil.
model FlowBot {
  flowId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  botId  String
  bot    Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([flowId, botId])
}

/// Configuração da seção "Boas-vindas" — roda no /start.
model WelcomeConfig {
  id        String  @id @default(cuid())
  flowId    String  @unique
  flow      Flow    @relation(fields: [flowId], references: [id], onDelete: Cascade)

  /// HTML restrito ao subset aceito pelo Telegram (parse_mode HTML):
  /// <b>/<i>/<u>/<s>/<code>/<blockquote>. Suporta variáveis {nome} etc,
  /// substituídas em src/bot/templating.ts.
  text                 String?
  secondaryMessageEnabled Boolean @default(false)
  ctaButtonEnabled     Boolean @default(false)
  ctaLabel             String?
  miniAppEnabled       Boolean @default(false)
  miniAppUrl           String?
  /// Canal/grupo padrão de entrega de conteúdo pra este funil — substitui
  /// o antigo TELEGRAM_VAULT_CHANNEL_ID global do .env.
  defaultDeliveryTarget String?

  media           WelcomeMedia[]
  redirectButtons RedirectButton[]
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
}

/// Até 3 mídias da mensagem de boas-vindas, em ordem.
model WelcomeMedia {
  id              String        @id @default(cuid())
  welcomeConfigId String
  welcomeConfig   WelcomeConfig @relation(fields: [welcomeConfigId], references: [id], onDelete: Cascade)
  order           Int
  mediaType       MediaType
  fileId          String

  @@unique([welcomeConfigId, order])
}

/// Até 3 botões de redirecionamento (URL externa) nas boas-vindas.
model RedirectButton {
  id              String        @id @default(cuid())
  welcomeConfigId String
  welcomeConfig   WelcomeConfig @relation(fields: [welcomeConfigId], references: [id], onDelete: Cascade)
  order           Int
  label           String
  url             String

  @@unique([welcomeConfigId, order])
}

enum PlanButtonColor {
  PADRAO
  AZUL
  VERDE
  VERMELHO
}

enum DeliveryType {
  FILE
  LINK
}

/// O que é vendido. `durationDays` nulo = pagamento único/vitalício;
/// preenchido = assinatura com expiração (renovação manual — ver
/// OrderItem.accessExpiresAt e src/payments/subscriptionScheduler.ts).
model Plan {
  id             String          @id @default(cuid())
  flowId         String
  flow           Flow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  name           String
  priceCents     Int
  durationDays   Int?
  buttonColor    PlanButtonColor @default(PADRAO)
  deliveryType   DeliveryType
  /// DeliveryType.FILE — message_id (não file_id) da mensagem no canal-cofre.
  fileTelegramId String?
  externalLink   String?
  /// Override do WelcomeConfig.defaultDeliveryTarget só pra este plano.
  customDeliveryTarget String?
  protectContent Boolean         @default(true)
  active         Boolean         @default(true)
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orderItems      OrderItem[]
  triggerOffers   Offer[]         @relation("OfferTrigger")
  offeredInOffers Offer[]         @relation("OfferOffered")
}

enum OfferKind {
  ORDER_BUMP
  UPSELL
  DOWNSELL
}

/// Regra "quando o cliente compra/recusa X, ofereça Y". O que é ofertado
/// (`offeredPlan`) é sempre um Plan normal — reaproveita preço/duração/
/// entrega já existentes. Order Bump dispara na tela de confirmação antes
/// do PIX (soma ao mesmo pagamento); Upsell dispara depois da entrega
/// (novo PIX à parte); Downsell dispara quando um Upsell é recusado
/// (`parentOfferId` aponta pro Upsell recusado).
model Offer {
  id            String    @id @default(cuid())
  triggerPlanId String
  triggerPlan   Plan      @relation("OfferTrigger", fields: [triggerPlanId], references: [id], onDelete: Cascade)
  offeredPlanId String
  offeredPlan   Plan      @relation("OfferOffered", fields: [offeredPlanId], references: [id], onDelete: Cascade)
  kind          OfferKind
  parentOfferId String?
  parentOffer   Offer?    @relation("OfferParent", fields: [parentOfferId], references: [id], onDelete: SetNull)
  childOffers   Offer[]   @relation("OfferParent")
  /// Texto do convite (HTML + variáveis, mesmo padrão de templating.ts).
  /// Vazio = usa um texto padrão genérico.
  message       String?
  /// Texto dos botões de aceitar/recusar — vazio usa um padrão por `kind`
  /// ("Sim, adicionar"/"Sim, quero" + "Não, obrigado").
  acceptLabel   String?
  declineLabel  String?
  order         Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum PaymentButtonStyle {
  PADRAO
  COMPACTO
}

/// Mensagens da seção "Pagamentos" (PIX gerado / aprovado).
model PaymentMessages {
  id     String @id @default(cuid())
  flowId String @unique
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  pixGeneratedMessage String?
  pixApprovedMessage  String?
  buttonStyle         PaymentButtonStyle @default(PADRAO)
  showConfirmationStep Boolean @default(false)
}

/// Uma cobrança PIX gerada. Cabeçalho — o que foi vendido de fato vive em
/// OrderItem (um Order pode ter mais de um item: plano base + order bumps
/// pagos na mesma cobrança — ver Fase 2, Milestone 1/4 do plano).
model Order {
  id          String @id @default(cuid())
  leadId      String
  lead        Lead   @relation(fields: [leadId], references: [id])
  botId       String
  bot         Bot    @relation(fields: [botId], references: [id])
  originId    String?
  origin      Origin? @relation(fields: [originId], references: [id])

  syncpayChargeId String      @unique
  amountCents     Int
  status          OrderStatus @default(PENDING)
  pixCopyPaste    String?
  qrCodeUrl       String?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  expiresAt   DateTime?

  items         OrderItem[]
  webhookEvents WebhookEvent[]

  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  REFUSED
  EXPIRED
}

enum OrderItemKind {
  BASE
  ORDER_BUMP
  UPSELL
  DOWNSELL
}

/// Uma linha de um Order — o Plan efetivamente vendido, seu preço no
/// momento da venda (pode divergir do Plan.priceCents atual se o preço
/// mudar depois) e, pra planos com duração (assinatura), o controle de
/// expiração/renovação/revogação de acesso (Fase 2, Milestone 5).
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planId  String
  plan    Plan   @relation(fields: [planId], references: [id])
  kind    OrderItemKind @default(BASE)
  unitPriceCents Int

  accessExpiresAt       DateTime?
  renewalReminderSentAt DateTime?
  revokedAt             DateTime?

  @@index([orderId])
}

/// Log bruto de todo webhook recebido da SyncPay — garante idempotência
/// (webhook duplicado não gera reprocessamento) e serve de trilha de auditoria.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("syncpay")
  externalId  String   // id do evento/transação na gateway
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
}
