// Schema único — fonte da verdade do modelo de dados.
// Ver ARCHITECTURE.md e PROJECT_STATE.md para o racional de cada entidade.
// Modelo "funil de seções fixas" (Bot -> Flow -> Boas-vindas/Planos/
// Pagamentos), não um grafo genérico de passos — ver
// C:\Users\gusta\.claude\plans\rippling-rolling-castle.md para o porquê.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tabela do connect-pg-simple (session store do express-session, ver
/// src/admin/routes.ts) — a lib gerencia essa tabela em runtime, não o
/// Prisma Client. Declarada aqui só pra Prisma Migrate saber que ela existe
/// de propósito e não tentar dropar como "tabela não referenciada".
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

/// Linha única (id fixo "singleton") de configurações globais do painel —
/// hoje só o canal de vendas, mas o padrão fica pronto pra crescer sem
/// precisar de variável de ambiente nova a cada config (evita redeploy).
model Settings {
  id             String  @id @default("singleton")
  /// Canal/grupo do Telegram (id numérico, ex: "-1001234567890") — "canal de
  /// registro" com duas funções: recebe a notificação de toda venda
  /// aprovada de todos os bots, E serve de armazenamento pra mídia
  /// enviada via upload no painel (src/bot/mediaUpload.ts) — mesmo campo
  /// pras duas coisas (decisão do usuário, 2026-08-20, espelhando a
  /// referência ApexVips). Nulo = notificação de venda cai no fallback
  /// antigo (DM pro TELEGRAM_ADMIN_USER_ID); upload de mídia fica bloqueado
  /// até configurar.
  salesChannelId String?
}

/// Fonte de tráfego rastreável: outro bot, canal, campanha etc.
/// `param` é o valor usado no deep link t.me/seu_bot?start=param
model Origin {
  id        String     @id @default(cuid())
  param     String     @unique
  label     String
  kind      OriginKind @default(OTHER)
  createdAt DateTime   @default(now())

  leads  Lead[]
  orders Order[]
}

enum OriginKind {
  BOT
  CHANNEL
  CAMPAIGN
  OTHER
}

/// Um bot do Telegram gerenciado pelo painel (substitui o antigo
/// TELEGRAM_BOT_TOKEN único no .env — agora dá pra ter vários).
model Bot {
  id                        String   @id @default(cuid())
  label                     String
  /// Token do BotFather, criptografado (AES-256-GCM via src/lib/crypto.ts).
  /// Nunca gravar em texto plano.
  telegramBotTokenEncrypted String
  telegramUsername          String?
  telegramUserId            BigInt?
  displayName               String?
  photoFileId               String?
  description               String?
  shortDescription          String?
  /// Usado no path do webhook (/telegram/webhook/:botId/:webhookSecret).
  webhookSecret             String
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  commands    BotCommand[]
  flows       FlowBot[]
  leads       Lead[]
  orders      Order[]
  broadcasts  Broadcast[]
  mediaAssets MediaAsset[]
}

/// Mídia enviada pelo admin direto pela tela (upload arrasta-e-solta em
/// /admin/bots/:id/media) — o servidor sobe o arquivo pro Telegram via
/// `Settings.salesChannelId` (mesmo canal de notificação de vendas,
/// reaproveitado como "canal de registro" de mídia também) usando o Bot
/// dono do upload, e guarda o file_id resultante. Um file_id só é válido
/// pro bot que o enviou, por isso fica vinculado a este `Bot` específico
/// (ver src/bot/mediaUpload.ts) — assume 1 bot por Flow, confirmado com o
/// usuário em 2026-08-20.
model MediaAsset {
  id        String    @id @default(cuid())
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  mediaType MediaType
  fileId    String
  /// Legenda do post no canal de mídias, se houver — usado só como rótulo
  /// de exibição na biblioteca, não afeta o envio.
  label     String?
  createdAt DateTime  @default(now())

  @@index([botId])
}

enum BotCommandKind {
  START
  SUPORTE
  STATUS
}

/// Comandos fixos do bot (/start, /suporte, /status) — só emoji e label
/// são editáveis, os comandos em si não mudam (igual ao Shark Bot).
model BotCommand {
  id    String         @id @default(cuid())
  botId String
  bot   Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  kind  BotCommandKind
  emoji String
  label String
  order Int

  @@unique([botId, kind])
}

/// Usuário do Telegram que já interagiu com um Bot específico. O mesmo
/// telegramId pode ser um Lead diferente em cada Bot (funis/vendas
/// separados por bot).
model Lead {
  id           String   @id @default(cuid())
  telegramId   BigInt
  botId        String
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  username     String?
  firstName    String?
  lastName     String?
  /// Código de idioma do cliente Telegram do usuário (ex: "pt-br", "en") —
  /// vem de ctx.from.language_code, exibido no canal de vendas rico.
  languageCode String?
  /// ctx.from.is_premium — exibido no canal de vendas rico.
  isPremium    Boolean  @default(false)
  originId     String?
  origin       Origin?  @relation(fields: [originId], references: [id])
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  orders                 Order[]
  scheduledUpsellSends   ScheduledUpsellSend[]
  scheduledDownsellSends ScheduledDownsellSend[]

  @@unique([telegramId, botId])
}

/// Um funil de vendas (pode ser vinculado a múltiplos Bots via FlowBot).
model Flow {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bots            FlowBot[]
  welcomeConfig   WelcomeConfig?
  paymentMessages PaymentMessages?
  plans           Plan[]
  upsellSequence  UpsellSequence?
  downsellConfig  DownsellConfig?
}

/// "Bots Vinculados" de um Flow — quais bots executam este funil.
model FlowBot {
  flowId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  botId  String
  bot    Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([flowId, botId])
}

/// Configuração da seção "Boas-vindas" — roda no /start.
model WelcomeConfig {
  id     String @id @default(cuid())
  flowId String @unique
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  /// HTML restrito ao subset aceito pelo Telegram (parse_mode HTML):
  /// <b>/<i>/<u>/<s>/<code>/<blockquote>. Suporta variáveis {nome} etc,
  /// substituídas em src/bot/templating.ts.
  text                    String?
  secondaryMessageEnabled Boolean @default(false)
  ctaButtonEnabled        Boolean @default(false)
  ctaLabel                String?
  miniAppEnabled          Boolean @default(false)
  miniAppUrl              String?
  /// Canal/grupo padrão de entrega de conteúdo pra este funil — substitui
  /// o antigo TELEGRAM_VAULT_CHANNEL_ID global do .env.
  defaultDeliveryTarget   String?

  media           WelcomeMedia[]
  redirectButtons RedirectButton[]
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
}

/// Até 3 mídias da mensagem de boas-vindas, em ordem.
model WelcomeMedia {
  id              String        @id @default(cuid())
  welcomeConfigId String
  welcomeConfig   WelcomeConfig @relation(fields: [welcomeConfigId], references: [id], onDelete: Cascade)
  order           Int
  mediaType       MediaType
  fileId          String

  @@unique([welcomeConfigId, order])
}

/// Até 3 botões de redirecionamento (URL externa) nas boas-vindas.
model RedirectButton {
  id              String        @id @default(cuid())
  welcomeConfigId String
  welcomeConfig   WelcomeConfig @relation(fields: [welcomeConfigId], references: [id], onDelete: Cascade)
  order           Int
  label           String
  url             String

  @@unique([welcomeConfigId, order])
}

enum PlanButtonColor {
  PADRAO
  AZUL
  VERDE
  VERMELHO
}

enum DeliveryType {
  FILE
  LINK
  /// Convite de uso único pro canal/grupo VIP em `Plan.subscriptionChannelId`
  /// — usado por planos de assinatura (Fase 2, Milestone 5). O bot precisa
  /// ser admin desse canal com permissão de convidar/remover membros.
  CHANNEL
}

/// O que é vendido. `durationDays` nulo = pagamento único/vitalício;
/// preenchido = assinatura com expiração (renovação manual — ver
/// OrderItem.accessExpiresAt e src/payments/subscriptionScheduler.ts).
model Plan {
  id                    String          @id @default(cuid())
  flowId                String
  flow                  Flow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  name                  String
  priceCents            Int
  durationDays          Int?
  buttonColor           PlanButtonColor @default(PADRAO)
  deliveryType          DeliveryType
  /// DeliveryType.FILE — message_id (não file_id) da mensagem no canal-cofre.
  fileTelegramId        String?
  externalLink          String?
  /// DeliveryType.CHANNEL — canal/grupo VIP pro qual gerar um convite de uso
  /// único na compra, e do qual remover o assinante quando expirar (ver
  /// src/payments/subscriptionScheduler.ts).
  subscriptionChannelId String?
  /// Override do WelcomeConfig.defaultDeliveryTarget só pra este plano.
  customDeliveryTarget  String?
  protectContent        Boolean         @default(true)
  active                Boolean         @default(true)
  order                 Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  orderItems            OrderItem[]
  triggerOffers         Offer[]                @relation("OfferTrigger")
  offeredInOffers       Offer[]                @relation("OfferOffered")
  upsellMessagePlans    UpsellMessagePlan[]
  upsellMessageButtons  UpsellMessageButton[]
  downsellSequencePlans DownsellSequencePlan[]
}

enum OfferKind {
  ORDER_BUMP
  /// Não usado mais pelo runtime (Upsell virou UpsellSequence/UpsellMessage,
  /// mais rico) — mantido no enum só pra não quebrar registros antigos/
  /// migração; a UI de Ofertas não cria mais `Offer` deste kind.
  UPSELL
  /// Idem — Downsell será redefinido (gatilho: PIX gerado e não pago
  /// depois de N minutos, não mais "Upsell recusado"). Ainda não
  /// implementado.
  DOWNSELL
}

/// Regra "quando o cliente compra X, ofereça Y" — hoje só usada pelo Order
/// Bump (dispara na tela de confirmação antes do PIX, soma ao mesmo
/// pagamento). `offeredPlan` é sempre um Plan normal — reaproveita preço/
/// duração/entrega já existentes.
model Offer {
  id            String    @id @default(cuid())
  triggerPlanId String
  triggerPlan   Plan      @relation("OfferTrigger", fields: [triggerPlanId], references: [id], onDelete: Cascade)
  offeredPlanId String
  offeredPlan   Plan      @relation("OfferOffered", fields: [offeredPlanId], references: [id], onDelete: Cascade)
  kind          OfferKind
  parentOfferId String?
  parentOffer   Offer?    @relation("OfferParent", fields: [parentOfferId], references: [id], onDelete: SetNull)
  childOffers   Offer[]   @relation("OfferParent")
  /// Texto do convite (HTML + variáveis, mesmo padrão de templating.ts).
  /// Vazio = usa um texto padrão genérico.
  message       String?
  /// Texto dos botões de aceitar/recusar — vazio usa um padrão por `kind`
  /// ("Sim, adicionar"/"Sim, quero" + "Não, obrigado").
  acceptLabel   String?
  declineLabel  String?
  order         Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Configuração de Upsell de um Flow — sequência de mensagens enviadas
/// automaticamente depois de QUALQUER compra feita nesse funil (não mais
/// vinculado a um plano-gatilho específico).
model UpsellSequence {
  id     String  @id @default(cuid())
  flowId String  @unique
  flow   Flow    @relation(fields: [flowId], references: [id], onDelete: Cascade)
  active Boolean @default(true)

  messages UpsellMessage[]
}

/// Uma mensagem da sequência de Upsell — texto, atraso (minutos após a
/// compra) e planos/botões próprios. Pode ter 0+ Planos anexados (exibidos
/// no painel separados por "assinatura"/"pacote" conforme
/// `Plan.durationDays`, mas é só agrupamento visual) e 0+ botões livres
/// (compram um dos planos anexados, ou abrem um link).
model UpsellMessage {
  id           String         @id @default(cuid())
  sequenceId   String
  sequence     UpsellSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order        Int            @default(0)
  text         String?
  /// Minutos após a compra pra enviar esta mensagem (0 = imediato).
  delayMinutes Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  plans          UpsellMessagePlan[]
  buttons        UpsellMessageButton[]
  scheduledSends ScheduledUpsellSend[]
}

/// Um Plan anexado a uma UpsellMessage — só pra ficar disponível pros
/// botões do tipo BUY_PLAN escolherem (o texto/preço já vem do Plan).
model UpsellMessagePlan {
  id        String        @id @default(cuid())
  messageId String
  message   UpsellMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  order     Int           @default(0)

  @@unique([messageId, planId])
}

enum UpsellButtonType {
  BUY_PLAN
  OPEN_LINK
}

/// Botão livre de uma UpsellMessage — texto editável, e o que faz ao
/// clicar: BUY_PLAN reaproveita o fluxo normal de compra de um dos Planos
/// anexados (gera PIX, cai no mesmo callback `plan:<id>` de sempre — inclui
/// Order Bump se o plano alvo tiver bumps configurados); OPEN_LINK é só um
/// link externo.
model UpsellMessageButton {
  id           String           @id @default(cuid())
  messageId    String
  message      UpsellMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  order        Int              @default(0)
  text         String
  type         UpsellButtonType
  targetPlanId String?
  targetPlan   Plan?            @relation(fields: [targetPlanId], references: [id], onDelete: Cascade)
  url          String?
}

/// Um envio agendado de UpsellMessage pra um Lead específico — uma linha
/// criada por mensagem da sequência no momento da compra, processada pelo
/// scheduler (src/bot/upsellScheduler.ts) quando `sendAt` chega.
model ScheduledUpsellSend {
  id        String        @id @default(cuid())
  messageId String
  message   UpsellMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  botId     String
  sendAt    DateTime
  sentAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([sendAt])
}

enum PaymentButtonStyle {
  PADRAO
  COMPACTO
}

/// Mensagens da seção "Pagamentos" (PIX gerado / aprovado).
model PaymentMessages {
  id     String @id @default(cuid())
  flowId String @unique
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  pixGeneratedMessage  String?
  pixApprovedMessage   String?
  buttonStyle          PaymentButtonStyle @default(PADRAO)
  showConfirmationStep Boolean            @default(false)
  /// Lembrete de renovação (Fase 2, Milestone 5) — mandado pelo
  /// src/payments/subscriptionScheduler.ts a 2 dias do vencimento de um
  /// OrderItem de assinatura, com botão que gera um PIX novo pro mesmo
  /// plano. Vazio = usa um texto padrão genérico.
  renewalMessage       String?
}

/// Uma cobrança PIX gerada. Cabeçalho — o que foi vendido de fato vive em
/// OrderItem (um Order pode ter mais de um item: plano base + order bumps
/// pagos na mesma cobrança — ver Fase 2, Milestone 1/4 do plano).
model Order {
  id       String  @id @default(cuid())
  leadId   String
  lead     Lead    @relation(fields: [leadId], references: [id])
  botId    String
  bot      Bot     @relation(fields: [botId], references: [id])
  originId String?
  origin   Origin? @relation(fields: [originId], references: [id])

  syncpayChargeId String      @unique
  amountCents     Int
  status          OrderStatus @default(PENDING)
  pixCopyPaste    String?
  qrCodeUrl       String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  expiresAt DateTime?

  items                  OrderItem[]
  webhookEvents          WebhookEvent[]
  scheduledDownsellSends ScheduledDownsellSend[]

  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  REFUSED
  EXPIRED
}

enum OrderItemKind {
  BASE
  ORDER_BUMP
  UPSELL
  DOWNSELL
}

/// Uma linha de um Order — o Plan efetivamente vendido, seu preço no
/// momento da venda (pode divergir do Plan.priceCents atual se o preço
/// mudar depois) e, pra planos com duração (assinatura), o controle de
/// expiração/renovação/revogação de acesso (Fase 2, Milestone 5).
model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  kind           OrderItemKind @default(BASE)
  unitPriceCents Int

  accessExpiresAt       DateTime?
  renewalReminderSentAt DateTime?
  revokedAt             DateTime?

  @@index([orderId])
}

enum DownsellTrigger {
  /// Dispara N minutos após o /start pra leads que nunca geraram pagamento.
  GENERAL
  /// Dispara N minutos após um PIX ser gerado e não pago. Quando há pelo
  /// menos 1 sequência PIX_GENERATED ativa, ela substitui (cancela de vez)
  /// os envios GENERAL pendentes daquele lead — ver
  /// src/bot/downsellScheduler.ts (scheduleDownsellForOrder).
  PIX_GENERATED
}

enum DiscountType {
  /// discountValue de 0 a 100.
  PERCENT
  /// discountValue em centavos.
  FIXED
}

/// Config global de Downsell de um Flow — um único liga/desliga pra todas
/// as sequências (Geral e PIX Gerado), igual ao toggle único mostrado nas
/// duas abas do painel de referência do usuário.
model DownsellConfig {
  id        String   @id @default(cuid())
  flowId    String   @unique
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequences DownsellSequence[]
}

/// Uma sequência de Downsell — mensagem + desconto, disparada `delayMinutes`
/// depois do gatilho (`trigger`). Até 20 por trigger (limite aplicado na
/// rota do painel, não no schema). Planos ad-hoc criados só pra oferta
/// ("Criar planos" na tela de referência) ficaram fora do escopo desta
/// versão — só reaproveita Planos já cadastrados no funil, com o desconto
/// calculado na hora da compra (ver src/bot/downsellMessage.ts).
model DownsellSequence {
  id            String          @id @default(cuid())
  configId      String
  config        DownsellConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  trigger       DownsellTrigger
  order         Int             @default(0)
  delayMinutes  Int             @default(5)
  discountType  DiscountType    @default(PERCENT)
  discountValue Int             @default(0)
  message       String          @db.Text
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  media          DownsellSequenceMedia[]
  plans          DownsellSequencePlan[]
  scheduledSends ScheduledDownsellSend[]
}

/// Até 3 mídias de uma DownsellSequence, em ordem (mesmo padrão de WelcomeMedia).
model DownsellSequenceMedia {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   DownsellSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  mediaType  MediaType
  fileId     String

  @@unique([sequenceId, order])
}

/// Um Plan mostrado nessa oferta de Downsell — o preço exibido/cobrado é o
/// do Plan com o desconto da sequência aplicado em cima, não um preço
/// próprio salvo aqui (ver applyDiscount em src/bot/downsellMessage.ts).
model DownsellSequencePlan {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   DownsellSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  order      Int              @default(0)

  @@unique([sequenceId, planId])
}

/// Um envio agendado de DownsellSequence pra um Lead — `orderId` presente
/// só pro trigger PIX_GENERATED (aponta pro PIX específico que ficou sem
/// pagar). Processado pelo poller (src/bot/downsellScheduler.ts) quando
/// `sendAt` chega. `canceledAt` marca envios GENERAL cancelados por
/// substituição (PIX gerado) ou por conversão (lead pagou).
model ScheduledDownsellSend {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   DownsellSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  botId      String
  orderId    String?
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sendAt     DateTime
  sentAt     DateTime?
  canceledAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([sendAt])
  @@index([leadId])
}

enum BroadcastSegment {
  ALL
  /// Leads com pelo menos 1 Order PAID (qualquer bot/funil).
  BUYERS
  /// Leads sem nenhum Order PAID.
  NON_BUYERS
}

enum BroadcastStatus {
  SENDING
  DONE
  /// Só usado se a varredura nem conseguir começar (ex: bot não registrado)
  /// — falha de mensagem individual não derruba o broadcast inteiro, vira
  /// failedCount.
  FAILED
}

/// Disparo de mensagem em massa pra um segmento de Leads de um Bot (Fase 2,
/// Milestone 6). Sem agendamento — dispara na hora, processado em background
/// por src/bot/broadcast.ts assim que criado.
model Broadcast {
  id              String           @id @default(cuid())
  botId           String
  bot             Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  segment         BroadcastSegment
  message         String           @db.Text
  status          BroadcastStatus  @default(SENDING)
  totalRecipients Int              @default(0)
  sentCount       Int              @default(0)
  failedCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
}

/// Contador regressivo ao vivo (`{countdown:S:I:delete}` no editor de texto,
/// 2026-08-20) — o bot edita a mensagem sozinho a cada `intervalSeconds` até
/// zerar. `markerTemplate` é o texto já renderizado (variáveis resolvidas)
/// com o contador trocado por um marcador interno — cada tick só substitui
/// o marcador pelo tempo restante, não re-renderiza o resto da mensagem.
model ScheduledCountdownEdit {
  id              String    @id @default(cuid())
  botId           String
  chatId          BigInt
  messageId       Int
  markerTemplate  String    @db.Text
  totalSeconds    Int
  intervalSeconds Int
  deleteOnZero    Boolean
  startedAt       DateTime  @default(now())
  nextTickAt      DateTime
  finishedAt      DateTime?

  @@index([nextTickAt])
}

/// Log bruto de todo webhook recebido da SyncPay — garante idempotência
/// (webhook duplicado não gera reprocessamento) e serve de trilha de auditoria.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("syncpay")
  externalId  String // id do evento/transação na gateway
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id])
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
}
