# Telegram
TELEGRAM_BOT_TOKEN=
# Secret aleatório usado no path do webhook do bot (ex: gerar com `openssl rand -hex 20`)
TELEGRAM_WEBHOOK_SECRET=
# Id numérico do seu usuário Telegram — recebe alertas de venda e pode usar comandos admin
TELEGRAM_ADMIN_USER_ID=
# Id do canal privado "cofre" onde os produtos (PDF/vídeo/áudio) são enviados uma vez
TELEGRAM_VAULT_CHANNEL_ID=

# SyncPay
SYNCPAY_API_KEY=
SYNCPAY_API_BASE_URL=https://api.syncpay.pro
# Segredo para validar a assinatura do webhook de confirmação de pagamento
SYNCPAY_WEBHOOK_SECRET=

# Banco de dados (Neon Postgres — connection string com sslmode=require)
DATABASE_URL=

# Painel admin
ADMIN_PANEL_PASSWORD=
SESSION_SECRET=

# App
PORT=3000
# URL pública do deploy (Render), usada para registrar os webhooks
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
