# Telegram
# Bots são cadastrados pelo painel (/admin/bots) -- não existe mais uma
# variável fixa de token aqui. O canal-cofre também passa a ser configurado
# por funil (WelcomeConfig.defaultDeliveryTarget), não globalmente.
# Id numérico do seu usuário Telegram — recebe alertas de venda e pode usar comandos admin
TELEGRAM_ADMIN_USER_ID=
# Chave usada pra criptografar o token de cada bot no banco (qualquer string
# longa serve, ex: `openssl rand -hex 32`)
BOT_TOKEN_ENCRYPTION_KEY=

# SyncPay (OAuth client_credentials — painel SyncPay > API > Client ID/Secret)
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_API_BASE_URL=https://api.syncpayments.com.br
# Segredo para validar a assinatura do webhook de confirmação de pagamento
SYNCPAY_WEBHOOK_SECRET=

# Banco de dados (Postgres rodando no docker-compose, no mesmo host/rede da app)
DATABASE_URL=postgresql://dgbot:CHANGE_ME@db:5432/dgbot
# Credenciais usadas pelo container postgres do docker-compose (devem bater com DATABASE_URL acima)
POSTGRES_USER=dgbot
POSTGRES_PASSWORD=
POSTGRES_DB=dgbot

# Domínio público apontando pro IP da VPS — necessário para o Caddy emitir TLS
PUBLIC_DOMAIN=

# Painel admin — login virou multi-usuário (model User no banco), cadastrado
# via `npm run user:create`, não uma senha fixa aqui.
SESSION_SECRET=

# App
PORT=3000
# URL pública do deploy (https://SEU_DOMINIO), usada para registrar os webhooks
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
